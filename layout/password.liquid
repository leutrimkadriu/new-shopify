<!doctype html><html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }}</title>{{ content_for_header }}{%- liquid
  assign body_font_bold = settings.type_body_font | font_modify: 'weight', '700'
  assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign heading_font_bold = settings.type_heading_font | font_modify: 'weight', '700'
  assign heading_font_italic = settings.type_heading_font | font_modify: 'style', 'italic'
  assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
-%}<style>{{ settings.type_body_font | font_face: font_display: 'swap' }}{{ body_font_bold | font_face: font_display: 'swap' }}{{ body_font_italic | font_face: font_display: 'swap' }}{{ body_font_bold_italic | font_face: font_display: 'swap' }}{{ settings.type_heading_font | font_face: font_display: 'swap' }}{{ heading_font_bold | font_face: font_display: 'swap' }}{{ heading_font_italic | font_face: font_display: 'swap' }}{{ heading_font_bold_italic | font_face: font_display: 'swap' }}:root{--nx-bg:{{ settings.color_background }};--nx-text:{{ settings.color_text }};--nx-muted:{{ settings.color_muted }};--nx-accent:{{ settings.color_accent }};--nx-accent-text:{{ settings.color_accent_text }};--nx-border:{{ settings.color_border }};--nx-surface-setting:{{ settings.color_surface }};--nx-dark-bg:{{ settings.color_dark_background }};--nx-dark-text:{{ settings.color_dark_text }};--nx-page:{{ settings.page_width }}px;--nx-section-space:{{ settings.section_spacing }}px;--nx-media-radius:{{ settings.media_radius }}px;--nx-button-radius:{{ settings.button_radius }}px;--nx-button-border:{{ settings.button_border_width }}px;--nx-card-radius:{{ settings.card_radius }}px;--nx-body-font:{{ settings.type_body_font.family }},sans-serif;--nx-heading-font:{{ settings.type_heading_font.family }},sans-serif;--nx-body-scale:{{ settings.body_scale | divided_by: 100.0 }};--nx-display-fluid:{{ settings.heading_scale | times: 0.06 }}vw;--nx-section-fluid:{{ settings.heading_scale | times: 0.04 }}vw;--nx-subheading-fluid:{{ settings.heading_scale | times: 0.017 }}vw;--nx-border-alpha:{{ settings.border_strength | divided_by: 100.0 }};}</style>{{ 'base.css' | asset_url | stylesheet_tag }}{{ 'components.css' | asset_url | stylesheet_tag }}{{ 'sections.css' | asset_url | stylesheet_tag }}</head><body><a class="nx-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a><main id="MainContent" tabindex="-1">{{ content_for_layout }}</main></body></html>
