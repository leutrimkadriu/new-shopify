<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }}</title>{{ content_for_header }}<style>{{ settings.type_body_font | font_face: font_display: 'swap' }}{{ settings.type_heading_font | font_face: font_display: 'swap' }}:root{--nx-bg:{{ settings.color_background }};--nx-text:{{ settings.color_text }};--nx-muted:{{ settings.color_muted }};--nx-accent:{{ settings.color_accent }};--nx-accent-text:{{ settings.color_accent_text }};--nx-border:{{ settings.color_border }};--nx-page:{{ settings.page_width }}px;--nx-body-font:{{ settings.type_body_font.family }},sans-serif;--nx-heading-font:{{ settings.type_heading_font.family }},sans-serif}</style>{{ 'base.css' | asset_url | stylesheet_tag }}{{ 'components.css' | asset_url | stylesheet_tag }}{{ 'sections.css' | asset_url | stylesheet_tag }}</head><body><main>{{ content_for_layout }}</main></body></html>
