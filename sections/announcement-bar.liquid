{% assign message_count = 0 %}
{% for block in section.blocks %}
  {% if block.settings.text != blank %}{% assign message_count = message_count | plus: 1 %}{% endif %}
{% endfor %}

{% if message_count > 0 %}
  <nx-announcement
    class="nx-announcement"
    data-id="{{ section.id }}"
    data-speed="{{ section.settings.speed }}"
    data-rotate="{{ section.settings.rotate }}"
    style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }}"
  >
    {% assign rendered_count = 0 %}
    {% for block in section.blocks %}
      {% if block.settings.text != blank %}
        <div data-announcement{% if rendered_count > 0 %} hidden{% endif %} {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
          {{ block.settings.text | escape }}
          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
        {% assign rendered_count = rendered_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if section.settings.dismissible %}
      <button class="nx-icon-button nx-announcement__dismiss" type="button" data-dismiss aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    {% endif %}
  </nx-announcement>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "rotate", "label": "Rotate messages", "default": true },
    { "type": "range", "id": "speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Rotation interval", "default": 6 },
    { "type": "checkbox", "id": "dismissible", "label": "Allow dismissal", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#171714" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary delivery on qualifying orders" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [{ "type": "message" }] }
  ]
}
{% endschema %}
