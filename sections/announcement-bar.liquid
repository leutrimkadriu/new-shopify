<nx-announcement class="nx-announcement" data-id="{{ section.id }}" data-speed="{{ section.settings.speed }}" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  {% for block in section.blocks %}<div data-announcement{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{{ block.settings.text | escape }}{% if block.settings.link != blank %}</a>{% endif %}{% if block.settings.end_date != blank %} · <nx-countdown data-end="{{ block.settings.end_date | escape }}" data-expired="Ended"><span data-days>00</span>d <span data-hours>00</span>h <span data-minutes>00</span>m</nx-countdown>{% endif %}</div>{% endfor %}
  {% if section.settings.dismissible %}<button class="nx-icon-button nx-announcement__dismiss" type="button" data-dismiss aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>{% endif %}
</nx-announcement>
{% schema %}{"name":"Announcement bar","limit":1,"enabled_on":{"groups":["header"]},"settings":[{"type":"checkbox","id":"rotate","label":"Rotate messages","default":true},{"type":"range","id":"speed","min":3,"max":12,"step":1,"unit":"s","label":"Rotation interval","default":6},{"type":"checkbox","id":"dismissible","label":"Allow dismissal","default":true},{"type":"color","id":"background","label":"Background","default":"#171714"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"}],"blocks":[{"type":"message","name":"Message","limit":5,"settings":[{"type":"text","id":"text","label":"Text","default":"Share an announcement"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"end_date","label":"Countdown end date","info":"Optional ISO date, for example 2027-12-01T20:00:00+01:00"}]}],"presets":[{"name":"Announcement bar","blocks":[{"type":"message"}]}]}{% endschema %}
