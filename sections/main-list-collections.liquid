<section class="nx-section nx-page-width">
  {% if section.settings.heading != blank %}<header class="nx-section-heading"><h1>{{ section.settings.heading | escape }}</h1></header>{% endif %}
  {% paginate collections by section.settings.per_page %}
    <div class="nx-product-grid" style="--nx-cols: 3">
      {% for collection in collections %}
        <article>
          <a href="{{ collection.url }}">
            {% if collection.featured_image %}
              {% render 'responsive-image', image: collection.featured_image, sizes: '(min-width: 990px) 33vw, 100vw' %}
            {% else %}
              <div class="nx-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <h2>{{ collection.title | escape }}</h2>
          </a>
          <p>{{ 'collections.general.products_count' | t: count: collection.all_products_count }}</p>
        </article>
      {% endfor %}
    </div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collections"},{"type":"range","id":"per_page","min":6,"max":36,"step":3,"label":"Collections per page","default":18}]}
{% endschema %}
