<section class="nx-section nx-page-width"><div class="nx-split-story{% if section.settings.reverse %} nx-split-story--reverse{% endif %}"><div class="nx-split-story__panel nx-split-story__media">{% render 'responsive-image', image: section.settings.image, sizes: '(min-width:990px) 60vw, 100vw' %}</div><div class="nx-split-story__panel"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="nx-rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'text', show_arrow: true %}{% endif %}</div></div></section>
{% schema %}{"name":"Image with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Behind the design"},{"type":"text","id":"heading","label":"Heading","default":"Made with intention"},{"type":"richtext","id":"text","label":"Text","default":"<p>Introduce the craft, materials, or philosophy behind your collection.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Learn more"},{"type":"url","id":"button_link","label":"Button link"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false}],"presets":[{"name":"Image with text"}]}{% endschema %}
