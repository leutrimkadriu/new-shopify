<section class="learning-locales">
{% for block in section.blocks %}

    {% case block.type %}

      {% when 'heading' %}
        <h1
          style="color:red"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.heading_text }}
        </h1>

    {% endcase %}

  {% endfor %}

  <button class="btn-shop-now">

  {{ 'general.view_all' | t: title: collection.title }}
 </button>

</section>

<style>
    .btn-shop-now{
        background:red;
        color:blue;
        border:none;
        border-radius:5px;
        padding:20px;
        font-size:30px;

    
    }
</style>

{% schema %}
{
  "name": "Learning locales",
  "settings": [],
  "blocks": [
  {
    "type": "title",
    "name": "Title",
    "settings": []
  },
  {
    "type": "price",
    "name": "Price",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_compare_price",
        "label": "Show compare-at price",
        "default": true
      }
    ]
  },
  {
    "type": "description",
    "name": "Description",
    "settings": [
      {
        "type": "checkbox",
        "id": "collapsible",
        "label": "Collapsible description",
        "default": false
      }
    ]
  },
  {
    "type": "variant_picker",
    "name": "Variant picker",
    "settings": []
  },
  {
    "type": "buy_buttons",
    "name": "Buy buttons",
    "settings": []
  }
],
  "presets": [
    {
      "name": "Learning locales"
    }
  ]
}
{% endschema %}