{% for block in section.blocks %}

  <div {{ block.shopify_attributes }}>

    {% case block.type %}

      {% when 'title' %}
        <h1>
          {{ product.title }}
        </h1>

      {% when 'price' %}
        <p>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>

        {% if block.settings.show_compare_price %}
          {% if product.selected_or_first_available_variant.compare_at_price
            > product.selected_or_first_available_variant.price
          %}
            <s>
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </s>
          {% endif %}
        {% endif %}

      {% when 'description' %}
        <div class="product-description">
          {{ product.description }}
        </div>

      {% when 'variant_picker' %}
        {% for option in product.options_with_values %}
          <p>{{ option.name }}</p>

          {% for value in option.values %}
            <button type="button">
              {{ value }}
            </button>
          {% endfor %}
        {% endfor %}

      {% when 'buy_buttons' %}
        <button type="submit">
          {{ 'products.product.add_to_cart' | t }}
        </button>

    {% endcase %}

  </div>

{% endfor %}

{% schema %}
{
  "name": "Learning locales",
  "settings": [],
  "blocks": [
  {
    "type": "title",
    "name": "Title",
    "settings": []
  },
  {
    "type": "price",
    "name": "Price",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_compare_price",
        "label": "Show compare-at price",
        "default": true
      }
    ]
  },
  {
    "type": "description",
    "name": "Description",
    "settings": [
      {
        "type": "checkbox",
        "id": "collapsible",
        "label": "Collapsible description",
        "default": false
      }
    ]
  },
  {
    "type": "variant_picker",
    "name": "Variant picker",
    "settings": []
  },
  {
    "type": "buy_buttons",
    "name": "Buy buttons",
    "settings": []
  }
],
  "presets": [
    {
      "name": "Learning locales"
    }
  ]
}
{% endschema %}