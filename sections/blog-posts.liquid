<section class="nx-section nx-page-width"><header class="nx-section-heading"><div><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.blog %}{% render 'button', label: section.settings.button_label, url: section.settings.blog.url, style: 'text', show_arrow: true %}{% endif %}</header><div class="nx-product-grid" style="--nx-cols:3">{% for article in section.settings.blog.articles limit: section.settings.limit %}<article>{% if article.image %}<a href="{{ article.url }}">{% render 'responsive-image', image: article.image, sizes: '(min-width:990px) 33vw, 100vw' %}</a>{% endif %}<div class="nx-eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</div><h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p></article>{% else %}{% for i in (1..3) %}<article><div class="nx-placeholder">{{ 'image' | placeholder_svg_tag }}</div><h3>Editorial story {{ i }}</h3><p>Use journal stories to add context to the collection.</p></article>{% endfor %}{% endfor %}</div></section>
{% schema %}{"name":"Blog posts","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Journal / Latest"},{"type":"text","id":"heading","label":"Heading","default":"Stories in context"},{"type":"blog","id":"blog","label":"Blog"},{"type":"range","id":"limit","min":2,"max":6,"step":1,"label":"Posts to show","default":3},{"type":"text","id":"button_label","label":"Button label","default":"View journal"}],"presets":[{"name":"Blog posts"}]}{% endschema %}
