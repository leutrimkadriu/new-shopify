<section class="nx-section nx-page-width">
  <div class="nx-shop-story">
    <div>
      {% if section.settings.eyebrow != blank %}<div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="nx-rte">{{ section.settings.text }}</div>{% endif %}
    </div>
    <div>
      {% assign visible_questions = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.question != blank and block.settings.answer != blank %}
          {% assign visible_questions = visible_questions | plus: 1 %}
          <details class="nx-accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }} {% render 'icon', icon: 'plus' %}</summary>
            <div class="nx-accordion__content nx-rte">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
      {% if request.design_mode and visible_questions == 0 %}<p class="nx-muted">{{ 'general.faq_editor_empty' | t }}</p>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Questions, answered"},{"type":"text","id":"heading","label":"Heading","default":"Good to know"},{"type":"richtext","id":"text","label":"Introduction","default":"<p>The useful details, gathered in one place.</p>"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}
{% endschema %}
