<section class="nx-section nx-page-width"><div class="nx-shop-story"><div><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.text }}</div><div>{% for block in section.blocks %}<details class="nx-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }} {% render 'icon', icon: 'plus' %}</summary><div class="nx-accordion__content nx-rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Questions, answered"},{"type":"text","id":"heading","label":"Heading","default":"Good to know"},{"type":"richtext","id":"text","label":"Introduction","default":"<p>Give customers clear answers before they need to ask.</p>"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What should customers know?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add a concise, useful answer.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
