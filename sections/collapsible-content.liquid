<section class="nx-section nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header>{% for block in section.blocks %}<details class="nx-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }} {% render 'icon', icon: 'plus' %}</summary><div class="nx-accordion__content nx-rte">{{ block.settings.content }}</div></details>{% endfor %}</section>
{% schema %}{"name":"Collapsible content","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"}],"blocks":[{"type":"row","name":"Row","settings":[{"type":"text","id":"heading","label":"Heading","default":"Add a heading"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add helpful supporting information.</p>"}]}],"presets":[{"name":"Collapsible content","blocks":[{"type":"row"},{"type":"row"}]}]}{% endschema %}
