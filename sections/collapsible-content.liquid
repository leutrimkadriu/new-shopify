{% assign visible_rows = 0 %}
{% for block in section.blocks %}
  {% if block.settings.heading != blank and block.settings.content != blank %}{% assign visible_rows = visible_rows | plus: 1 %}{% endif %}
{% endfor %}
{% if visible_rows > 0 or request.design_mode %}
  <section class="nx-section nx-page-width">
    {% if section.settings.heading != blank %}<header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header>{% endif %}
    {% for block in section.blocks %}
      {% if block.settings.heading != blank and block.settings.content != blank %}
        <details class="nx-accordion" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }} {% render 'icon', icon: 'plus' %}</summary>
          <div class="nx-accordion__content nx-rte">{{ block.settings.content }}</div>
        </details>
      {% endif %}
    {% endfor %}
    {% if request.design_mode and visible_rows == 0 %}<p class="nx-muted">{{ 'general.collapsible_editor_empty' | t }}</p>{% endif %}
  </section>
{% endif %}
{% schema %}
{"name":"Collapsible content","settings":[{"type":"text","id":"heading","label":"Heading","default":"Details"}],"blocks":[{"type":"row","name":"Row","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Content"}]}],"presets":[{"name":"Collapsible content","blocks":[{"type":"row"},{"type":"row"}]}]}
{% endschema %}
