<section class="nx-section nx-page-width"><div class="nx-contact"><div><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h1>{{ section.settings.heading | escape }}</h1>{{ section.settings.text }}</div>{% form 'contact' %}{% if form.posted_successfully? %}<p tabindex="-1">{{ 'contact.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<div class="nx-field"><label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name"></div><div class="nx-field"><label for="ContactEmail">{{ 'contact.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div><div class="nx-field"><label for="ContactPhone">{{ 'contact.phone' | t }}</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel"></div><div class="nx-field"><label for="ContactMessage">{{ 'contact.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="8" required></textarea></div><button class="nx-button" type="submit">{{ 'contact.send' | t }}</button>{% endform %}</div></section>
{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Contact"},{"type":"text","id":"heading","label":"Heading","default":"Start a conversation"},{"type":"richtext","id":"text","label":"Body text","default":"<p>Tell customers when and how your team will reply.</p>"}],"presets":[{"name":"Contact form"}]}{% endschema %}
