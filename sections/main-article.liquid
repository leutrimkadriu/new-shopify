{% render 'breadcrumbs' %}<article class="nx-article"><header class="nx-article__header"><div class="nx-eyebrow">{% if section.settings.show_date %}{{ article.published_at | date: '%B %d, %Y' }}{% endif %}{% if section.settings.show_author %} · {{ article.author | escape }}{% endif %}</div><h1>{{ article.title | escape }}</h1></header>{% if article.image %}<div class="nx-article__image">{% render 'responsive-image', image: article.image, loading: 'eager', fetchpriority: 'high', sizes: '860px' %}</div>{% endif %}<div class="nx-rte">{{ article.content }}</div>{% if section.settings.show_share %}<div><span>{{ 'general.share' | t }}:</span> <a href="https://www.facebook.com/sharer.php?u={{ canonical_url | url_encode }}">Facebook</a> <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}{% if article.image %}&media=https:{{ article.image | image_url: width: 1200 | url_encode }}{% endif %}">Pinterest</a></div>{% endif %}<a href="{{ blog.url }}">{{ 'blogs.article.back' | t: title: blog.title }}</a></article>
{% schema %}{"name":"Article","settings":[{"type":"checkbox","id":"show_date","label":"Show date","default":true},{"type":"checkbox","id":"show_author","label":"Show author","default":true},{"type":"checkbox","id":"show_share","label":"Show sharing links","default":true}]}{% endschema %}
