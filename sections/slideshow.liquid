<section class="nx-slideshow-section">
  <nx-slideshow class="nx-slideshow" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}" data-section-id="{{ section.id }}">
    <div class="nx-slideshow__slides" data-slide-live aria-live="{% if section.settings.autoplay %}off{% else %}polite{% endif %}">
      {% for block in section.blocks %}
        {%- liquid
          assign slide_loading = 'lazy'
          assign slide_priority = 'auto'
          if section.index == 1 and forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif
        -%}
        <article class="nx-slideshow__slide" data-slide data-block-id="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="nx-slideshow__media" style="--nx-overlay: {{ block.settings.overlay | divided_by: 100.0 }}">
            {% if block.settings.image != blank %}
              {% if block.settings.mobile_image != blank %}
                <picture>
                  <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w, {{ block.settings.mobile_image | image_url: width: 750 }} 750w, {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">
                  {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '640,960,1280,1600,2000,2400', sizes: '100vw', loading: slide_loading, fetchpriority: slide_priority, alt: block.settings.image.alt }}
                </picture>
              {% else %}
                {% render 'responsive-image', image: block.settings.image, sizes: '100vw', loading: slide_loading, fetchpriority: slide_priority %}
              {% endif %}
            {% else %}
              <div class="nx-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </div>
          <div class="nx-slideshow__content nx-page-width nx-text-{{ block.settings.alignment }}">
            {% if block.settings.eyebrow != blank %}<div class="nx-eyebrow">{{ block.settings.eyebrow | escape }}</div>{% endif %}
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
            {% if block.settings.text != blank %}<div class="nx-rte">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.button_label != blank %}{% render 'button', label: block.settings.button_label, url: block.settings.button_link %}{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="nx-slideshow__controls no-js-hidden">
        <button type="button" data-slide-previous aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'arrow' %}</button>
        <span data-slide-status data-slide-live aria-live="{% if section.settings.autoplay %}off{% else %}polite{% endif %}">1 / {{ section.blocks.size }}</span>
        <button type="button" data-slide-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'arrow' %}</button>
        {% if section.settings.autoplay %}
          <button type="button" data-slide-toggle data-pause="{{ 'accessibility.pause_slideshow' | t }}" data-play="{{ 'accessibility.play_slideshow' | t }}" aria-label="{{ 'accessibility.pause_slideshow' | t }}">{% render 'icon', icon: 'pause' %}</button>
        {% endif %}
      </div>
    {% endif %}
  </nx-slideshow>
</section>

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Enable automatic slide rotation", "default": false },
    { "type": "range", "id": "speed", "min": 4, "max": 12, "step": 1, "unit": "s", "label": "Change slides every", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "range", "id": "overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Image overlay opacity", "default": 25 },
        { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "The new edit" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A new point of view" },
        { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Pair an editorial story with a direct path to the collection.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
