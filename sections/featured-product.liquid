{% assign product = section.settings.product %}{% assign view_product_label = 'products.product.view_product' | t %}{% if product %}<section class="nx-section nx-page-width"><div class="nx-featured-product"><div>{% render 'responsive-image', image: product.featured_image, sizes: '(min-width:990px) 55vw, 100vw' %}</div><div class="nx-product-info"><div class="nx-eyebrow">{{ product.vendor | escape }}</div><h2>{{ product.title | escape }}</h2>{% render 'price', product: product %}<div class="nx-rte">{{ product.description | strip_html | truncatewords: 45 }}</div>{% render 'button', label: view_product_label, url: product.url %}{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'custom_liquid' %}{{ block.settings.custom_liquid }}{% endcase %}{% endfor %}</div></div></section>{% else %}<section class="nx-section nx-page-width"><div class="nx-featured-product"><div class="nx-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div><div><div class="nx-eyebrow">Featured object</div><h2>Select a product</h2><p>Choose a product to create a focused commerce moment.</p></div></div></section>{% endif %}
{% schema %}{"name":"Featured product","settings":[{"type":"product","id":"product","label":"Product"}],"blocks":[{"type":"@app"},{"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"custom_liquid","label":"Custom Liquid"}]}],"presets":[{"name":"Featured product"}]}{% endschema %}
