<section class="nx-section nx-page-width"><div class="nx-story-product"><div class="nx-story-product__media nx-reveal">{% if section.settings.video %}{{ section.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: true, image_size: '1400x' }}{% else %}{% render 'responsive-image', image: section.settings.image, sizes: '(min-width:990px) 62vw, 100vw' %}{% endif %}{% for block in section.blocks %}<button class="nx-hotspot" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%" type="button" aria-label="{{ block.settings.product.title | default: 'Featured product' | escape }}" {{ block.shopify_attributes }}>{{ forloop.index | prepend: '0' }}</button>{% endfor %}</div><div class="nx-reveal"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="nx-rte">{{ section.settings.text }}</div><div class="nx-story-product__products">{% for block in section.blocks %}{% if block.settings.product %}{% render 'product-card', card_product: block.settings.product, card_style: 'minimal' %}{% endif %}{% endfor %}</div></div></div></section>
{% schema %}{"name":"Editorial product story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"video","id":"video","label":"Video"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Object study / 01"},{"type":"text","id":"heading","label":"Heading","default":"Form meets function"},{"type":"richtext","id":"text","label":"Text","default":"<p>Pair the details behind your design with the products that bring the story to life.</p>"}],"blocks":[{"type":"product","name":"Product hotspot","limit":4,"settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"x","min":5,"max":95,"step":1,"unit":"%","label":"Horizontal position","default":50},{"type":"range","id":"y","min":5,"max":95,"step":1,"unit":"%","label":"Vertical position","default":50}]}],"presets":[{"name":"Editorial product story","blocks":[{"type":"product"},{"type":"product"}]}]}{% endschema %}
