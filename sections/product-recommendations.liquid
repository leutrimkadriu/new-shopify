<product-recommendations class="nx-section nx-page-width" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"{% if recommendations.performed %} data-loaded="true"{% endif %}>{% if recommendations.performed and recommendations.products_count > 0 %}<header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="nx-product-grid" style="--nx-cols:{{ section.settings.columns }}">{% for product in recommendations.products %}{% render 'product-card', card_product: product %}{% endfor %}</div>{% endif %}</product-recommendations><script>if(!customElements.get('product-recommendations'))customElements.define('product-recommendations',class extends HTMLElement{connectedCallback(){if(this.dataset.loaded)return;const io=new IntersectionObserver(async([e])=>{if(!e.isIntersecting)return;io.disconnect();try{const h=await fetch(this.dataset.url).then(r=>r.text());const d=new DOMParser().parseFromString(h,'text/html');const candidates=[...d.querySelectorAll('product-recommendations')];const n=candidates.find(node=>node.dataset.url===this.dataset.url)||candidates[0];if(n)this.innerHTML=n.innerHTML}catch(_){this.hidden=true}});io.observe(this)}});</script>
{% schema %}{"name":"Product recommendations","settings":[{"type":"text","id":"heading","label":"Heading","default":"Continue the edit"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"label":"Products to show","default":4},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Desktop columns","default":4}],"presets":[{"name":"Product recommendations"}]}{% endschema %}
