{%- liquid
  assign hero_focal_point = section.settings.image.presentation.focal_point | default: '50% 50%'
  assign hero_mobile_focal_point = section.settings.mobile_image.presentation.focal_point | default: hero_focal_point
-%}
<section
  class="nx-hero"
  style="--nx-hero-height: {{ section.settings.height }}vh; --nx-mobile-height: {{ section.settings.mobile_height }}svh; --nx-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --nx-x: {{ section.settings.horizontal }}; --nx-y: {{ section.settings.vertical }}; --nx-align: {{ section.settings.alignment }}; --nx-hero-text: {{ section.settings.text_color }}; --nx-hero-focal: {{ hero_focal_point }}; --nx-hero-mobile-focal: {{ hero_mobile_focal_point }}"
>
  <div class="nx-hero__media">
    {% if section.settings.video %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1800x' }}
    {% elsif section.settings.image %}
      <picture>
        {% if section.settings.mobile_image %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 900 }} 900w
            "
            sizes="100vw"
          >
        {% endif %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '640,960,1280,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', style: 'object-position: var(--nx-hero-focal)', alt: section.settings.image.alt }}
      </picture>
    {% elsif section.settings.mobile_image %}
      {{ section.settings.mobile_image | image_url: width: 1200 | image_tag: widths: '480,750,900,1200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', style: 'object-position: var(--nx-hero-mobile-focal)', alt: section.settings.mobile_image.alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>

  {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
    <div class="nx-hero__content">
      {% if section.settings.eyebrow != blank %}<div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.text != blank %}<div class="nx-rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.primary_label != blank and section.settings.primary_link != blank or section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
        <div class="nx-hero__buttons">
          {% render 'button', label: section.settings.primary_label, url: section.settings.primary_link %}
          {% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_link, style: 'outline' %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Edition 01 / Considered objects" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for the rhythm of now" },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>A confident canvas for products with a point of view.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore the edit" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "range", "id": "height", "min": 45, "max": 100, "step": 5, "unit": "vh", "label": "Desktop height", "default": 85 },
    { "type": "range", "id": "mobile_height", "min": 50, "max": 100, "step": 5, "unit": "vh", "label": "Mobile height", "default": 75 },
    { "type": "range", "id": "overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 25 },
    {
      "type": "select",
      "id": "horizontal",
      "label": "Horizontal position",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "vertical",
      "label": "Vertical position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "end"
    },
    { "type": "text_alignment", "id": "alignment", "label": "Text alignment", "default": "left" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
