<section class="nx-section nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-page-width nx-text-center"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><nx-countdown data-end="{{ section.settings.end_date | escape }}" data-expired="{{ section.settings.expired_text | escape }}"><span data-days>00</span> days · <span data-hours>00</span> hours · <span data-minutes>00</span> minutes · <span data-seconds>00</span> seconds</nx-countdown></div></section>
{% schema %}{"name":"Countdown","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A date to remember"},{"type":"text","id":"heading","label":"Heading","default":"Next release"},{"type":"text","id":"end_date","label":"End date","info":"ISO date, for example 2027-12-01T20:00:00+01:00","default":"2027-12-01T20:00:00+01:00"},{"type":"text","id":"expired_text","label":"Expired message","default":"This event has ended"},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"dark"}],"presets":[{"name":"Countdown"}]}{% endschema %}
