<section class="nx-section nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="nx-product-grid" style="--nx-cols:{{ section.settings.columns }}">{% for block in section.blocks %}<article {{ block.shopify_attributes }}>{% if block.settings.image %}{% render 'responsive-image', image: block.settings.image, sizes: '(min-width:990px) 25vw, 50vw' %}{% endif %}<div class="nx-eyebrow">{{ forloop.index | prepend: '0' }}</div><h3>{{ block.settings.heading | escape }}</h3>{{ block.settings.text }}{% if block.settings.link_label != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Columns","settings":[{"type":"text","id":"heading","label":"Heading","default":"What defines us"},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Desktop columns","default":3}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Considered detail"},{"type":"richtext","id":"text","label":"Body text","default":"<p>Explain one part of your product or service.</p>"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Columns","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}{% endschema %}
