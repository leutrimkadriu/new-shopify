<section class="nx-split-story{% if section.settings.reverse %} nx-split-story--reverse{% endif %}"><div class="nx-split-story__panel nx-split-story__media{% if section.settings.reverse %} nx-order-2{% endif %}">{% if section.settings.video %}{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1400x' }}{% else %}{% render 'responsive-image', image: section.settings.image, sizes: '(min-width:990px) 65vw, 100vw' %}{% endif %}</div><div class="nx-split-story__panel nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="nx-rte">{{ section.settings.text }}</div>{% if section.settings.product %}{% render 'product-card', card_product: section.settings.product, card_style: 'minimal' %}{% elsif section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'text', show_arrow: true %}{% endif %}</div></section>
{% schema %}{"name":"Split commerce story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"video","id":"video","label":"Video"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Material note / 03"},{"type":"text","id":"heading","label":"Heading","default":"A study in contrast"},{"type":"richtext","id":"text","label":"Text","default":"<p>Use an asymmetric composition to connect an editorial idea to a collection or product.</p>"},{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"button_label","label":"Button label","default":"Read the story"},{"type":"url","id":"button_link","label":"Button link"},{"type":"checkbox","id":"reverse","label":"Reverse layout","default":false},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"dark"}],"presets":[{"name":"Split commerce story"}]}{% endschema %}
