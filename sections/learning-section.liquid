<section class="learning-section">
  <h2>{{ section.settings.heading }}</h2>

  <p>{{ section.settings.text }}</p>
</section>

<style>
  .learning-section {
    padding: 40px;
    text-align: center;
  }
  .learning-section h2 {
    font-size: 40px;
    margin-bottom: 15px;
  }
  .learning-section p {
    font-size: 18px;
  }
</style>

{% schema %}
{
  "name": "Learning section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My first Shopify section"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "I am learning Shopify Liquid."
    }
  ],
  "presets": [
    {
      "name": "Learning section"
    }
  ]
}
{% endschema %}
