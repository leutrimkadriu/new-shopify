{% assign heading = section.settings.heading %}
{% assign text = section.settings.text %}
{% assign image = section.settings.image %}
{% assign button_text = section.settings.button_text %}
{% assign button_link = section.settings.button_link %}

<section class="learning-section">
  {% for block in section.blocks %}
    <div class="learning-block" {{ block.shopify_attributes }}>
      <h3>{{ block.settings.title }}</h3>

      <p>{{ block.settings.text }}</p>
    </div>
  {% endfor %}

  {% if image != blank %}
    {{ image | image_url: width: 800 | image_tag: alt: heading }}
  {% endif %}
  <h2>{{ heading }}</h2>

  <p>{{ text }}</p>

  {% if button_text != blank %}
    <a class="learning-button" href="{{button_link }}">
      {{ button_text }}
    </a>
  {% endif %}
</section>

<style>
      .learning-section {
        padding: {{ section.settings.section_padding }}px;
        background: {{ section.settings.section_background }};

        text-align: center;
      }
      .learning-section img{
    width:100%;
    max-width:600px;
    height:auto;
    margin: bottom 20px;
    }
      .learning-section h2 {
        font-size: 40px;
        margin-bottom: 15px;
      }
      .learning-section p {
        font-size: 18px;
      }
      .learning-button {
        display: inline-block;
        padding: 12px 14px;
        background: {{  section.settings.button_color  }};
        color: white;
        text-decoration: none;
        margin-top: 20px;
      }
      .learning-blocks {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 30px;
  }

  .learning-block {
    padding: 20px;
    border: 1px solid #dddddd;
    width: 250px;
  }

  .learning-block h3 {
    margin-bottom: 10px;
  }
</style>

{% schema %}
{
  "name": "Learning section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My first Shopify section"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "I am learning Shopify Liquid."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "My title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "My block text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Learning section"
    }
  ]
}
{% endschema %}
