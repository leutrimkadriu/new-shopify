{% assign heading = section.settings.heading %}
{% assign text = section.settings.text %}
{% assign image = section.settings.image %}
{% assign button_text = section.settings.button_text %}
{% assign button_link = section.settings.button_link %}
{% assign selected_product = section.settings.product %}

{% if selected_product != blank %}
  {% assign current_variant = selected_product.selected_or_first_available_variant
    | default: selected_product.variants.first
  %}
{% endif %}

<section
  id="learning-section-{{ section.id }}"
  class="learning-section"
>
  {% comment %}
    BLOCKS
  {% endcomment %}

  {% if section.blocks.size > 0 %}
    <div class="learning-blocks">
      {% for block in section.blocks %}
        <div
          class="learning-block"
          {{ block.shopify_attributes }}
        >
          <span> Item {{ forloop.index }} </span>

          {% if forloop.first %}
            <strong>First item</strong>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% comment %}
    SECTION IMAGE
  {% endcomment %}

  {% if image != blank %}
    {{ image | image_url: width: 800 | image_tag: alt: heading, loading: 'lazy' }}
  {% endif %}

  {% comment %}
    HEADING
  {% endcomment %}

  {% if heading != blank %}
    <h2>{{ heading }}</h2>
  {% endif %}

  {% comment %}
    TEXT
  {% endcomment %}

  {% if text != blank %}
    <p>{{ text }}</p>
  {% endif %}

  {% comment %}
    BUTTON
  {% endcomment %}

  {% if button_text != blank and button_link != blank %}
    <a
      class="learning-button"
      href="{{ button_link }}"
    >
      {{ button_text }}
    </a>
  {% endif %}

  {% comment %}
    PRODUCT
  {% endcomment %}

  {% if selected_product != blank %}
    <div class="learning-product">
      {% if selected_product.featured_image != blank %}
        {{
          selected_product.featured_image
          | image_url: width: 600
          | image_tag: alt: selected_product.title, loading: 'lazy'
        }}
      {% endif %}

      {% comment %}
        SALE
      {% endcomment %}

      {% if selected_product.compare_at_price > selected_product.price %}
        {% assign discount_amount = selected_product.compare_at_price | minus: selected_product.price %}

        {% assign discount_percent = discount_amount | times: 100 | divided_by: selected_product.compare_at_price %}

        <p class="sale-badge">Sale -{{ discount_percent }}%</p>
      {% endif %}

      {% comment %}
        SOLD OUT
      {% endcomment %}

      {% unless selected_product.available %}
        <p class="sold-out-badge">Sold Out</p>
      {% endunless %}

      <h3>
        {{ selected_product.title }}
      </h3>

      {% comment %}
        PRODUCT PRICE
      {% endcomment %}

      <div class="learning-price">
        {% if selected_product.compare_at_price > selected_product.price %}
          <s>
            {{ selected_product.compare_at_price | money }}
          </s>

          <span>
            {{ selected_product.price | money }}
          </span>

        {% else %}
          <span>
            {{ selected_product.price | money }}
          </span>
        {% endif %}
      </div>

      <a href="{{ selected_product.url }}"> View product </a>
    </div>

    {% comment %}
      PRODUCT FORM
    {% endcomment %}

    {% if current_variant != blank %}
      {% form 'product', selected_product, class: 'learning-product-form' %}
        <label for="variant-select-{{ section.id }}"> Variant </label>

        <select
          id="variant-select-{{ section.id }}"
          class="variant-select"
        >
          {% for variant in selected_product.variants %}
            <option
              value="{{ variant.id }}"
              data-available="{{ variant.available }}"

              {% if variant.id == current_variant.id %}
                selected
              {% endif %}

              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              {{ variant.title }}
              -
              {{ variant.price | money }}

              {% unless variant.available %}
                - Sold out
              {% endunless %}
            </option>
          {% endfor %}
        </select>

        <input
          type="hidden"
          name="id"
          class="variant-id"
          value="{{ current_variant.id }}"
        >

        <label for="quantity-{{ section.id }}"> Quantity </label>

        <input
          id="quantity-{{ section.id }}"
          type="number"
          name="quantity"
          class="quantity"
          value="1"
          min="1"
        >

        <button
          type="submit"
          class="add-to-cart-button"

          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {% if current_variant.available %}
            Add to cart
          {% else %}
            Sold out
          {% endif %}
        </button>

        <p class="cart-status">
          Cart items:
          <span class="cart-count">
            {{ cart.item_count }}
          </span>
        </p>

        <p
          class="cart-message"
          aria-live="polite"
        ></p>
      {% endform %}
    {% endif %}

    {% comment %}
      VARIANT LIST
      Kjo pjesë është vetëm për mësim.
    {% endcomment %}

    <div class="learning-variants">
      <h3>Variants</h3>

      {% for variant in selected_product.variants %}
        <div class="learning-variant">
          <p>
            {{ variant.title }}
          </p>

          <p>
            {{ variant.price | money }}
          </p>

          <small> Variant ID: {{ variant.id }} </small>

          {% unless variant.available %}
            <p>Sold out</p>
          {% endunless %}
        </div>
      {% endfor %}
    </div>

    {% comment %}
      CURRENT VARIANT INFO
      Edhe kjo është për mësim.
    {% endcomment %}

    {% if current_variant != blank %}
      <div class="current-variant-info">
        <p>
          Selected variant:
          {{ current_variant.title }}
        </p>

        <p>
          Variant ID:
          {{ current_variant.id }}
        </p>

        <p>
          Price:
          {{ current_variant.price | money }}
        </p>
      </div>
    {% endif %}
  {% endif %}

</section>
<div style="padding: 30px; background: yellow; color: black;">
  <p>design_mode: {{ request.design_mode }}</p>
  <p>visual_preview_mode: {{ request.visual_preview_mode }}</p>

  {% if request.design_mode %}
    <strong>THEME EDITOR ✅</strong>
  {% else %}
    <strong>STORE NORMAL ❌</strong>
  {% endif %}
</div>
<div>
  {{ shop.domain }}
</div>


<style>
  #learning-section-{{ section.id }} {
    padding: {{ section.settings.section_padding }}px;
    background: {{ section.settings.section_background }};
    text-align: center;
  }


  #learning-section-{{ section.id }} > img {
    width: 100%;
    max-width: 600px;
    height: auto;
    margin-bottom: 20px;
  }


  #learning-section-{{ section.id }} h2 {
    font-size: 40px;
    margin-bottom: 15px;
  }


  #learning-section-{{ section.id }} p {
    font-size: 18px;
  }


  #learning-section-{{ section.id }} .learning-button {
    display: inline-block;

    padding: 12px 24px;
    margin-top: 20px;

    background: {{ section.settings.button_color }};
    color: white;

    text-decoration: none;
  }


  #learning-section-{{ section.id }} .learning-blocks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;

    gap: 20px;

    margin-bottom: 30px;
  }


  #learning-section-{{ section.id }} .learning-block {
    width: 250px;
    padding: 20px;

    border: 1px solid #dddddd;
  }


  #learning-section-{{ section.id }} .learning-block h3 {
    margin-bottom: 10px;
  }


  #learning-section-{{ section.id }} .learning-product {
    max-width: 300px;

    margin: 40px auto 20px;
    padding: 20px;

    border: 1px solid #dddddd;
  }


  #learning-section-{{ section.id }} .learning-product img {
    width: 100%;
    height: auto;
  }


  #learning-section-{{ section.id }} .learning-product h3 {
    margin-top: 15px;
  }


  #learning-section-{{ section.id }} .learning-product a {
    display: inline-block;
    margin-top: 10px;
  }


  #learning-section-{{ section.id }} .learning-price {
    display: flex;
    justify-content: center;
    gap: 10px;

    margin-top: 10px;
  }


  #learning-section-{{ section.id }} .sale-badge {
    font-weight: bold;
  }


  #learning-section-{{ section.id }} .sold-out-badge {
    font-weight: bold;
  }


  #learning-section-{{ section.id }} .learning-product-form {
    max-width: 300px;

    margin: 20px auto;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }


  #learning-section-{{ section.id }} .learning-product-form select,
  #learning-section-{{ section.id }} .learning-product-form input,
  #learning-section-{{ section.id }} .learning-product-form button {
    padding: 10px;
  }


  #learning-section-{{ section.id }} .add-to-cart-button {
    cursor: pointer;
  }


  #learning-section-{{ section.id }} .add-to-cart-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }


  #learning-section-{{ section.id }} .learning-variants {
    max-width: 600px;
    margin: 40px auto;
  }


  #learning-section-{{ section.id }} .learning-variant {
    padding: 15px;

    border-bottom: 1px solid #dddddd;
  }


  #learning-section-{{ section.id }} .cart-message {
    min-height: 24px;
  }
</style>

<script>
  (() => {

    const sectionEl = document.querySelector(
      '#learning-section-{{ section.id }}'
    );

    if (!sectionEl) {
      return;
    }


    const variantSelect =
      sectionEl.querySelector('.variant-select');

    const variantInput =
      sectionEl.querySelector('.variant-id');

    const form =
      sectionEl.querySelector('.learning-product-form');

    const quantityInput =
      sectionEl.querySelector('.quantity');

    const message =
      sectionEl.querySelector('.cart-message');

    const cartCount =
      sectionEl.querySelector('.cart-count');

    const addToCartButton =
      sectionEl.querySelector('.add-to-cart-button');


    {% comment %}
      VARIANT CHANGE
    {% endcomment %}

    if (variantSelect && variantInput) {

      variantSelect.addEventListener('change', function () {

        variantInput.value = variantSelect.value;

        console.log(
          'Selected variant ID:',
          variantSelect.value
        );

      });

    }


    {% comment %}
      ADD TO CART AJAX
    {% endcomment %}

    if (
      !form ||
      !variantInput ||
      !quantityInput
    ) {
      return;
    }


    form.addEventListener('submit', async function (event) {

      event.preventDefault();


      const variantId =
        Number(variantInput.value);

      const quantity =
        Number(quantityInput.value);


      if (!variantId || quantity < 1) {

        if (message) {
          message.textContent =
            'Please select a valid variant and quantity.';
        }

        return;
      }


      const data = {
        items: [
          {
            id: variantId,
            quantity: quantity
          }
        ]
      };


      console.log(
        'Sending to Shopify:',
        data
      );


      try {

        if (addToCartButton) {
          addToCartButton.disabled = true;
          addToCartButton.textContent = 'Adding...';
        }


        if (message) {
          message.textContent = '';
        }


        const response = await fetch(
          window.Shopify.routes.root + 'cart/add.js',
          {
            method: 'POST',

            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },

            body: JSON.stringify(data)
          }
        );


        if (!response.ok) {

          let errorMessage =
            'Could not add product';

          try {

            const errorData =
              await response.json();

            if (errorData.description) {
              errorMessage =
                errorData.description;
            }

          } catch (parseError) {
            console.error(parseError);
          }

          throw new Error(errorMessage);
        }


        const result =
          await response.json();


        console.log(
          'Added product:',
          result
        );


        {% comment %}
          GET UPDATED CART
        {% endcomment %}

        const cartResponse = await fetch(
          window.Shopify.routes.root + 'cart.js',
          {
            headers: {
              'Accept': 'application/json'
            }
          }
        );


        if (!cartResponse.ok) {
          throw new Error(
            'Could not load cart'
          );
        }


        const cart =
          await cartResponse.json();


        console.log(
          'Updated cart:',
          cart
        );


        if (cartCount) {
          cartCount.textContent =
            cart.item_count;
        }


        if (message) {
          message.textContent =
            'Product added to cart!';
        }


      } catch (error) {

        console.error(error);


        if (message) {
          message.textContent =
            error.message;
        }


      } finally {

        if (addToCartButton) {

          addToCartButton.disabled = false;

          addToCartButton.textContent =
            'Add to cart';

        }

      }

    });

  })();
</script>

{% schema %}
{
  "name": "Learning section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My first Shopify section"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "I am learning Shopify Liquid."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],

  "blocks": [
    {
      "type": "item",
      "name": "Item",

      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "My title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "My block text"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Learning section"
    }
  ]
}
{% endschema %}
