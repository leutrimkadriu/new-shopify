<section class="learning-section">
  <h2>{{ section.settings.heading }}</h2>

  <p>{{ section.settings.text }}</p>
  {% if section.settings.button_text != blank %}
    <a class="learning-button" href="{{ section.settings.button_link }}">
      {{ section.settings.button_text }}
    </a>
  {% endif %}
</section>

<style>
  .learning-section {
    padding: {{ section.settings.section_padding }}px;
    text-align: center;
  }
  .learning-section h2 {
    font-size: 40px;
    margin-bottom: 15px;
  }
  .learning-section p {
    font-size: 18px;
  }
  .learning-button {
    display: inline-block;
    padding: 12px 14px;
    background: {{ section.settings.section_background }};
    color: {{  section.settings.button_color }};
    text-decoration: none;
    margin-top: 20px;
  }
</style>

{% schema %}
{
  "name": "Learning section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My first Shopify section"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "I am learning Shopify Liquid."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Learning section"
    }
  ]
}
{% endschema %}
