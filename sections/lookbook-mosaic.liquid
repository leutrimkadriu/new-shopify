<section class="nx-section nx-page-width"><header class="nx-section-heading"><div><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2></div></header><div class="nx-mosaic">{% for block in section.blocks %}<article class="nx-mosaic__item nx-mosaic__item--{{ block.settings.size }} nx-reveal" {{ block.shopify_attributes }}>{% case block.type %}{% when 'image' %}{% render 'responsive-image', image: block.settings.image, sizes: '(min-width:990px) 50vw, 100vw' %}{% when 'product' %}{% if block.settings.product %}{% render 'responsive-image', image: block.settings.product.featured_image, sizes: '(min-width:990px) 33vw, 100vw' %}<a class="nx-mosaic__caption" href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }} · {{ block.settings.product.price | money }}</a>{% else %}<div class="nx-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}{% when 'collection' %}{% if block.settings.collection %}{% render 'responsive-image', image: block.settings.collection.image, sizes: '(min-width:990px) 50vw, 100vw' %}<a class="nx-mosaic__caption" href="{{ block.settings.collection.url }}">{{ block.settings.collection.title | escape }}</a>{% endif %}{% when 'text' %}<div class="nx-split-story__panel nx-color nx-color--dark"><div class="nx-eyebrow">{{ block.settings.eyebrow | escape }}</div><h3>{{ block.settings.heading | escape }}</h3>{{ block.settings.text }}</div>{% endcase %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Product lookbook mosaic","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Visual index / 04"},{"type":"text","id":"heading","label":"Heading","default":"The complete composition"}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"size","label":"Size","options":[{"value":"standard","label":"Standard"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}],"default":"standard"}]},{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"select","id":"size","label":"Size","options":[{"value":"standard","label":"Standard"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}],"default":"tall"}]},{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"size","label":"Size","options":[{"value":"standard","label":"Standard"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}],"default":"wide"}]},{"type":"text","name":"Text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Field note"},{"type":"text","id":"heading","label":"Heading","default":"Objects in context"},{"type":"richtext","id":"text","label":"Text","default":"<p>Balance imagery with an editorial pause.</p>"},{"type":"select","id":"size","label":"Size","options":[{"value":"standard","label":"Standard"},{"value":"wide","label":"Wide"},{"value":"tall","label":"Tall"}],"default":"standard"}]}],"max_blocks":12,"presets":[{"name":"Product lookbook mosaic","blocks":[{"type":"image"},{"type":"text"},{"type":"product"},{"type":"image"}]}]}{% endschema %}
