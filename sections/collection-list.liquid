<section class="nx-section nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="nx-product-grid" style="--nx-cols:{{ section.settings.columns }}">{% for block in section.blocks %}<article {{ block.shopify_attributes }}>{% if block.settings.collection %}<a href="{{ block.settings.collection.url }}">{% render 'responsive-image', image: block.settings.collection.featured_image, sizes: '(min-width:990px) 33vw, 100vw' %}<h3>{{ block.settings.collection.title | escape }}</h3></a>{% else %}<div class="nx-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div><h3>Collection</h3>{% endif %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by perspective"},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Desktop columns","default":3}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Collection list","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}{% endschema %}
