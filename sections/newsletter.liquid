<section class="nx-section nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-page-width nx-text-center"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2>{{ section.settings.text }}{% form 'customer', class: 'nx-search-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Newsletter-{{ section.id }}">{{ 'general.email' | t }}</label><input id="Newsletter-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.email' | t }}" aria-describedby="NewsletterStatus-{{ section.id }}"><button class="nx-icon-button" aria-label="{{ 'general.subscribe' | t }}">{% render 'icon', icon: 'arrow' %}</button><div id="NewsletterStatus-{{ section.id }}" aria-live="polite">{% if form.posted_successfully? %}<p>{{ 'general.newsletter_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}</div>{% endform %}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Private access"},{"type":"text","id":"heading","label":"Heading","default":"Ideas, objects, and new arrivals"},{"type":"richtext","id":"text","label":"Body text","default":"<p>Receive considered releases and stories.</p>"},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"dark"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
