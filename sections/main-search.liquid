<section class="nx-section nx-page-width"><header class="nx-search-hero"><h1>{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1><form class="nx-search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">{{ 'search.title' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><button class="nx-icon-button" aria-label="{{ 'search.submit' | t }}">{% render 'icon', icon: 'search' %}</button></form></header>{% paginate search.results by section.settings.results_per_page %}<div class="nx-product-grid" style="--nx-cols:{{ section.settings.columns }}">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% else %}<article><div class="nx-eyebrow">{{ item.object_type }}</div><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncate: 180 }}</p></article>{% endif %}{% else %}{% if search.performed %}<p>{{ 'search.no_results' | t }}</p>{% endif %}{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Search results","settings":[{"type":"range","id":"results_per_page","min":8,"max":40,"step":4,"label":"Results per page","default":20},{"type":"range","id":"columns","min":2,"max":5,"step":1,"label":"Desktop columns","default":4}]}{% endschema %}
