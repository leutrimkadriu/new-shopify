<section class="nx-section nx-page-width"><div class="nx-eyebrow nx-text-center">{{ section.settings.heading | escape }}</div><div class="nx-product-grid" style="--nx-cols:{{ section.settings.columns }}">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.link %}<a href="{{ block.settings.link }}">{% endif %}{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', widths: '120,240,320', alt: block.settings.logo.alt }}{% else %}<div class="nx-placeholder">{{ 'logo' | placeholder_svg_tag }}</div>{% endif %}{% if block.settings.link %}</a>{% endif %}</div>{% endfor %}</div></section>
{% schema %}{"name":"Logo list","settings":[{"type":"text","id":"heading","label":"Heading","default":"As seen with"},{"type":"range","id":"columns","min":2,"max":6,"step":1,"label":"Desktop columns","default":5}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Logo list","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}
