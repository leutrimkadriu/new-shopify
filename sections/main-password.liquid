<section class="nx-hero nx-color nx-color--dark">
  <div class="nx-hero__content">
    <div class="nx-eyebrow">{{ shop.name | escape }}</div>
    <h1>{{ 'templates.password.title' | t }}</h1>
    {% if shop.password_message != blank %}<div class="nx-rte">{{ shop.password_message }}</div>{% else %}<p>{{ 'templates.password.subtext' | t }}</p>{% endif %}
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label for="Password">{{ 'templates.password.enter' | t }}</label>
      <div class="nx-search-form">
        <input id="Password" type="password" name="password" required>
        <button class="nx-icon-button" aria-label="{{ 'general.submit' | t }}">{% render 'icon', icon: 'arrow' %}</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}{"name":"Password page","settings":[]}{% endschema %}
