<footer class="nx-footer">
  <div class="nx-footer__inner nx-page-width">
    <div class="nx-footer__grid">
      <div class="nx-footer__brand-column">
        <a class="nx-footer__brand" href="{{ routes.root_url }}">
          {% if settings.logo %}
            {{ settings.logo | image_url: width: settings.logo_width | image_tag: widths: '100, 140, 180, 240, 320, 440', width: settings.logo_width, alt: shop.name }}
          {% else %}
            <span>{{ shop.name | default: 'VEYLUNE' | escape }}</span>
          {% endif %}
        </a>
        {% if section.settings.show_newsletter %}
          <div class="nx-footer__newsletter">
            <p class="nx-footer__newsletter-title">{{ section.settings.newsletter_heading | escape }}</p>
            {% form 'customer', class: 'nx-footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterEmail">{{ 'general.email' | t }}</label>
              <input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.email' | t }}">
              <button class="nx-footer__submit" type="submit" aria-label="{{ 'general.subscribe' | t }}">{% render 'icon', icon: 'arrow' %}</button>
              {% if form.posted_successfully? %}<p class="nx-footer__form-status">{{ 'general.newsletter_success' | t }}</p>{% endif %}
              {{ form.errors | default_errors }}
            {% endform %}
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <div class="nx-footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h2 class="nx-footer__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
          {% case block.type %}
            {% when 'menu' %}
              <ul class="nx-footer__menu" role="list">
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                {% endfor %}
              </ul>
            {% when 'text' %}
              {% if block.settings.text != blank %}<div class="nx-footer__text nx-rte">{{ block.settings.text }}</div>{% endif %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    {% assign has_social_links = false %}
    {% if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_pinterest != blank or settings.social_youtube != blank %}{% assign has_social_links = true %}{% endif %}
    {% if section.settings.show_social and has_social_links %}
      <div class="nx-footer__social-row">
        <span class="nx-eyebrow">{{ 'general.follow' | t }}</span>
        {% render 'social-icons' %}
      </div>
    {% endif %}

    {% if section.settings.show_follow_on_shop %}<div class="nx-footer__follow">{{ shop | login_button: action: 'follow' }}</div>{% endif %}

    <div class="nx-footer__bottom">
      <div class="nx-footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
        <span>{{ powered_by_link }}</span>
        {% for policy in shop.policies %}
          {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}
        {% endfor %}
      </div>

      <div class="nx-footer__utilities">
        {% if section.settings.show_localization %}{% render 'localization-form', id: 'footer' %}{% endif %}
        {% if section.settings.show_payments and shop.enabled_payment_types.size > 0 %}
          <ul class="nx-footer__payments" role="list" aria-label="{{ 'general.payment_methods' | t }}">
            {% for type in shop.enabled_payment_types %}
              <li class="nx-footer__payment">{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "enabled_on": {"groups": ["footer"]},
  "settings": [
    {"type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": false},
    {"type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Private access to new editions"},
    {"type": "checkbox", "id": "show_social", "label": "Show social media icons", "default": true},
    {"type": "checkbox", "id": "show_follow_on_shop", "label": "Show Follow on Shop", "default": true},
    {"type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true},
    {"type": "checkbox", "id": "show_localization", "label": "Show localization", "default": true}
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer menu",
      "limit": 4,
      "settings": [
        {"type": "text", "id": "heading", "label": "Heading", "default": "Explore"},
        {"type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer"}
      ]
    },
    {
      "type": "text",
      "name": "Body text",
      "settings": [
        {"type": "text", "id": "heading", "label": "Heading", "default": "About"},
        {"type": "richtext", "id": "text", "label": "Body text", "default": "<p>A point of view shaped by thoughtful design and everyday ritual.</p>"}
      ]
    }
  ]
}
{% endschema %}
