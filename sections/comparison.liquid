<section class="nx-section nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="nx-product-grid" style="--nx-cols:{{ section.blocks.size }}">{% for block in section.blocks %}<article class="nx-product-card nx-product-card--commerce" {{ block.shopify_attributes }}>{% if block.settings.product %}{% render 'product-card', card_product: block.settings.product, card_style: 'minimal' %}{% else %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}<ul>{% if block.settings.feature_1 != blank %}<li>{{ block.settings.feature_1 | escape }}</li>{% endif %}{% if block.settings.feature_2 != blank %}<li>{{ block.settings.feature_2 | escape }}</li>{% endif %}{% if block.settings.feature_3 != blank %}<li>{{ block.settings.feature_3 | escape }}</li>{% endif %}</ul></article>{% endfor %}</div></section>
{% schema %}{"name":"Product comparison","settings":[{"type":"text","id":"heading","label":"Heading","default":"Compare the details"}],"blocks":[{"type":"item","name":"Comparison item","limit":4,"settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"heading","label":"Fallback heading","default":"Option"},{"type":"text","id":"feature_1","label":"Feature","default":"Key feature"},{"type":"text","id":"feature_2","label":"Feature","default":"Material or specification"},{"type":"text","id":"feature_3","label":"Feature","default":"Best suited for"}]}],"presets":[{"name":"Product comparison","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}{% endschema %}
