<section class="nx-section nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div class="nx-product-grid" style="--nx-cols:3">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote | escape }}”</blockquote><figcaption><strong>{{ block.settings.name | escape }}</strong>{% if block.settings.context != blank %}<br><span class="nx-muted">{{ block.settings.context | escape }}</span>{% endif %}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}{"name":"Testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"In their words"},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"default"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"Add a genuine customer quote here."},{"type":"text","id":"name","label":"Name","default":"Customer name"},{"type":"text","id":"context","label":"Context","default":"Verified customer"}]}],"presets":[{"name":"Testimonials","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}{% endschema %}
