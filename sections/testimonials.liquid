{% assign has_testimonials = false %}
{% for block in section.blocks %}
  {% if block.settings.quote != blank %}{% assign has_testimonials = true %}{% endif %}
{% endfor %}

{% if has_testimonials or request.design_mode %}
  <section class="nx-section nx-color nx-color--{{ section.settings.color_scheme }}">
    <div class="nx-page-width">
      {% if section.settings.heading != blank %}
        <header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header>
      {% endif %}
      <div class="nx-testimonials" style="--nx-cols: {{ section.settings.columns }}">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank %}
            <figure class="nx-testimonial" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="nx-testimonial__image">{% render 'responsive-image', image: block.settings.image, sizes: '72px' %}</div>
              {% endif %}
              {% if block.settings.rating > 0 %}
                <div class="nx-testimonial__rating" aria-label="{{ 'general.rating' | t: rating: block.settings.rating, scale: 5 }}">
                  {% for i in (1..5) %}<span aria-hidden="true">{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
                </div>
              {% endif %}
              <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
              <figcaption>
                {% if block.settings.name != blank %}<strong>{{ block.settings.name | escape }}</strong>{% endif %}
                {% if block.settings.context != blank %}<span class="nx-muted">{{ block.settings.context | escape }}</span>{% endif %}
              </figcaption>
            </figure>
          {% endif %}
        {% endfor %}
        {% if request.design_mode and has_testimonials == false %}
          <p class="nx-muted">{{ 'general.testimonial_editor_empty' | t }}</p>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their words" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer image" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "context", "label": "Role or location" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 0, "info": "Choose 0 to hide the rating." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
