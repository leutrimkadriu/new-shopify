<section class="nx-section nx-page-width"><header class="nx-section-heading"><h2>{{ section.settings.heading | escape }}</h2></header><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><figure>{% render 'responsive-image', image: section.settings.before_image, sizes: '50vw' %}<figcaption>{{ section.settings.before_label | escape }}</figcaption></figure><figure>{% render 'responsive-image', image: section.settings.after_image, sizes: '50vw' %}<figcaption>{{ section.settings.after_label | escape }}</figcaption></figure></div></section>
{% schema %}{"name":"Before and after","settings":[{"type":"text","id":"heading","label":"Heading","default":"See the difference"},{"type":"image_picker","id":"before_image","label":"Before image"},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"image_picker","id":"after_image","label":"After image"},{"type":"text","id":"after_label","label":"After label","default":"After"}],"presets":[{"name":"Before and after"}]}{% endschema %}
