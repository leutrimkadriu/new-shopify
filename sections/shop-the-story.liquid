<section class="nx-section nx-page-width"><div class="nx-shop-story"><div class="nx-shop-story__editorial"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="nx-rte">{{ section.settings.text }}</div><div class="nx-shop-story__media">{% render 'responsive-image', image: section.settings.image, sizes: '(min-width:990px) 38vw, 100vw' %}</div>{% if section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: 'text', show_arrow: true %}{% endif %}</div><div class="nx-product-grid" style="--nx-cols:2">{% for block in section.blocks %}{% if block.settings.product %}{% render 'product-card', card_product: block.settings.product, card_style: 'editorial' %}{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Shop the story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop the story / 05"},{"type":"text","id":"heading","label":"Heading","default":"A collection with context"},{"type":"richtext","id":"text","label":"Text","default":"<p>Build desire through a story, then make every featured piece easy to discover.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"button_label","label":"Button label","default":"Discover the collection"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"product","name":"Product","limit":6,"settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Shop the story","blocks":[{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}
