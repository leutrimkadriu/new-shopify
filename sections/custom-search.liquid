<section class="custom-search-section">

  <div class="page-width">

    <h1>Search</h1>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
      >

      <button type="submit">
        Search
      </button>
    </form>


    {% if search.performed %}

      <h2>
        Search results for "{{ search.terms }}"
      </h2>

      <p>
        {{ search.results_count }} results found
      </p>


      {% if search.results_count > 0 %}

        <div class="search-results">

          {% for item in search.results %}

            <div class="search-result-item">

              {% if item.object_type == 'product' %}

                {% if item.featured_image %}
                  <a href="{{ item.url }}">
                    {{
                      item.featured_image
                      | image_url: width: 500
                      | image_tag:
                        loading: 'lazy',
                        alt: item.title
                    }}
                  </a>
                {% endif %}

                <h3>
                  <a href="{{ item.url }}">
                    {{ item.title }}
                  </a>
                </h3>

                <p>
                  {{ item.price | money }}
                </p>


              {% elsif item.object_type == 'article' %}

                <h3>
                  <a href="{{ item.url }}">
                    {{ item.title }}
                  </a>
                </h3>

                {% if item.excerpt != blank %}
                  <p>
                    {{ item.excerpt | strip_html | truncate: 150 }}
                  </p>
                {% endif %}


              {% elsif item.object_type == 'page' %}

                <h3>
                  <a href="{{ item.url }}">
                    {{ item.title }}
                  </a>
                </h3>

                {% if item.content != blank %}
                  <p>
                    {{ item.content | strip_html | truncate: 150 }}
                  </p>
                {% endif %}

              {% endif %}

            </div>

          {% endfor %}

        </div>

      {% else %}

        <p>
          No results found for "{{ search.terms }}"
        </p>

      {% endif %}

    {% else %}

      <p>
        Enter a search term above.
      </p>

    {% endif %}

  </div>

</section>


<style>
  .custom-search-section {
    padding: 50px 20px;
  }

  .custom-search-section .page-width {
    max-width: 1200px;
    margin: 0 auto;
  }

  .custom-search-section form {
    display: flex;
    gap: 10px;
    margin-bottom: 40px;
  }

  .custom-search-section input {
    flex: 1;
    padding: 12px;
    border: 1px solid #ccc;
  }

  .custom-search-section button {
    padding: 12px 24px;
    cursor: pointer;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .search-result-item {
    border: 1px solid #ddd;
    padding: 15px;
  }

  .search-result-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .search-result-item h3 {
    margin-top: 15px;
  }

  .search-result-item a {
    color: inherit;
    text-decoration: none;
  }

  @media screen and (max-width: 990px) {
    .search-results {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .custom-search-section form {
      flex-direction: column;
    }

    .search-results {
      grid-template-columns: 1fr;
    }
  }
</style>


{% schema %}
{
  "name": "Custom search",
  "settings": [],
  "presets": [
    {
      "name": "Custom search"
    }
  ]
}
{% endschema %}