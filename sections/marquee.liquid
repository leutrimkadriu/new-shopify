<section class="nx-section nx-section--flush nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-marquee" aria-label="{{ section.settings.text | escape }}"><div class="nx-marquee__track" style="--speed:{{ section.settings.speed }}s">{% for i in (1..10) %}<span class="nx-marquee__item">{{ section.settings.text | escape }} ·</span>{% endfor %}</div></div></section>
{% schema %}{"name":"Scrolling text","settings":[{"type":"text","id":"text","label":"Text","default":"Design with intention"},{"type":"range","id":"speed","min":15,"max":60,"step":5,"unit":"s","label":"Speed","default":30},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"default"}],"presets":[{"name":"Scrolling text"}]}{% endschema %}
