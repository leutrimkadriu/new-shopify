<section class="nx-section nx-color nx-color--{{ section.settings.color_scheme }}"><div class="nx-page-width nx-text-center"><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2><div class="nx-rte" style="margin-inline:auto">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: section.settings.button_style %}{% endif %}</div></section>
{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VEYLORA note"},{"type":"text","id":"heading","label":"Heading","default":"A clear point of view"},{"type":"richtext","id":"text","label":"Text","default":"<p>Use this space for a concise brand statement or an important customer promise.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"button_style","label":"Button style","options":[{"value":"solid","label":"Solid"},{"value":"outline","label":"Outline"},{"value":"text","label":"Text link"}],"default":"text"},{"type":"select","id":"color_scheme","label":"Color scheme","options":[{"value":"default","label":"Default"},{"value":"dark","label":"Dark"},{"value":"accent","label":"Accent"}],"default":"default"}],"presets":[{"name":"Rich text"}]}{% endschema %}
