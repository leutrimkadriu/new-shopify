{% assign selected_product = section.settings.product %}
{% assign current_variant = selected_product.selected_or_first_available_variant %}

{% if selected_product != blank %}

  <div
    class="product-box"
    id="product-box-{{ section.id }}"
  >

    <h1>{{ selected_product.title }}</h1>

    <p id="product-price-{{ section.id }}">
      {{ current_variant.price | money }}
    </p>


  

    <div
      class="product-gallery"
      id="product-gallery-{{ section.id }}"
    >

      {% for media in selected_product.media %}

        {% if media.media_type == 'image' %}

          <div
            class="gallery-item"
            data-color="{{ media.alt | strip | downcase | escape }}"
          >

            {{
              media.preview_image
              | image_url: width: 900
              | image_tag:
                class: 'gallery-image',
                loading: 'lazy',
                alt: media.alt
            }}

          </div>

        {% endif %}

      {% endfor %}

    </div>


  

    {% for option in selected_product.options_with_values %}

      <h3>{{ option.name }}</h3>

      <div
        class="product-options"
        data-option-position="{{ option.position }}"
        data-option-name="{{ option.name | escape }}"
      >

        {% for option_value in option.values %}

          <label class="product-option">

            <input
              type="radio"
              name="option-{{ section.id }}-{{ option.position }}"
              value="{{ option_value.name | escape }}"
              data-option-name="{{ option.name | escape }}"
              {% if option_value.selected %}
                checked
              {% endif %}
            >

            {% if option_value.swatch.image %}

              {{
                option_value.swatch.image
                | image_url: width: 100
                | image_tag:
                  class: 'swatch-image',
                  alt: option_value.name
              }}

            {% elsif option_value.swatch.color %}

              <span
                class="color-swatch"
                style="
                  background-color:
                  rgb({{ option_value.swatch.color.rgb }});
                "
                title="{{ option_value.name }}"
              ></span>

            {% else %}

              <span class="option-text">
                {{ option_value.name }}
              </span>

            {% endif %}

          </label>

        {% endfor %}

      </div>

    {% endfor %}


    <p>
      Variant:
      <strong id="variant-title-{{ section.id }}">
        {{ current_variant.title }}
      </strong>
    </p>

    <p>
      Variant ID:
      <strong id="variant-id-{{ section.id }}">
        {{ current_variant.id }}
      </strong>
    </p>


    <script
      type="application/json"
      id="variant-data-{{ section.id }}"
    >
      [
        {% for variant in selected_product.variants %}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "priceFormatted": {{ variant.price | money | json }},
            "image":
              {% if variant.featured_image %}
                {{ variant.featured_image | image_url: width: 900 | json }}
              {% else %}
                null
              {% endif %}
          }
          {% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

  </div>

{% else %}

  <p>Select a product in Theme Editor.</p>

{% endif %}


<style>

  .product-box {
    max-width: 1000px;
    margin: 0 auto;
  }


  /* GALLERY */

  .product-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 30px;
  }

  .gallery-item {
    display: none;
  }

  .gallery-item.is-visible {
    display: block;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }


  /* OPTIONS */

  .product-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .product-option {
    cursor: pointer;
    position: relative;
  }

  .product-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }


  /* COLOR SWATCH */

  .color-swatch {
    display: block;
    width: 42px;
    height: 42px;
    border: 2px solid #ccc;
    border-radius: 50%;
  }


  /* IMAGE SWATCH */

  .swatch-image {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: cover;
    border: 2px solid #ccc;
    border-radius: 8px;
  }


  /* TEXT OPTION */

  .option-text {
    display: block;
    padding: 10px 16px;
    border: 2px solid #ccc;
    border-radius: 6px;
  }


  /* SELECTED */

  .product-option input:checked + .color-swatch,
  .product-option input:checked + .swatch-image,
  .product-option input:checked + .option-text {
    border-color: #000;
    border-width: 3px;
  }


  @media screen and (max-width: 749px) {

    .product-gallery {
      grid-template-columns: 1fr;
    }

  }

</style>


<script>
(function() {

  const productBox =
    document.getElementById('product-box-{{ section.id }}');

  if (!productBox) return;


  const variantData =
    document.getElementById('variant-data-{{ section.id }}');

  if (!variantData) return;


  const variants =
    JSON.parse(variantData.textContent);


  const inputs =
    productBox.querySelectorAll(
      'input[type="radio"]'
    );


  const galleryItems =
    productBox.querySelectorAll(
      '.gallery-item'
    );


  const variantTitle =
    document.getElementById(
      'variant-title-{{ section.id }}'
    );


  const variantId =
    document.getElementById(
      'variant-id-{{ section.id }}'
    );


  const productPrice =
    document.getElementById(
      'product-price-{{ section.id }}'
    );


  function getSelectedOptions() {

    const selectedOptions = [];


    const optionGroups =
      productBox.querySelectorAll(
        '.product-options'
      );


    optionGroups.forEach(function(group) {

      const checkedInput =
        group.querySelector(
          'input[type="radio"]:checked'
        );


      if (checkedInput) {

        selectedOptions.push(
          checkedInput.value
        );

      }

    });


    return selectedOptions;

  }


  function getSelectedColor() {

    let selectedColor = null;


    inputs.forEach(function(input) {

      if (
        input.checked &&
        input.dataset.optionName.toLowerCase() === 'color'
      ) {

        selectedColor =
          input.value.toLowerCase().trim();

      }

    });


    return selectedColor;

  }


  function updateGallery() {

    const selectedColor =
      getSelectedColor();


    if (!selectedColor) {

      galleryItems.forEach(function(item) {

        item.classList.add('is-visible');

      });

      return;

    }


    let foundImages = false;


    galleryItems.forEach(function(item) {

      const imageColor =
        item.dataset.color
          .toLowerCase()
          .trim();


      if (imageColor === selectedColor) {

        item.classList.add('is-visible');

        foundImages = true;

      } else {

        item.classList.remove('is-visible');

      }

    });


    /*
      Nëse nuk gjendet asnjë foto
      me alt text të ngjyrës,
      i shfaqim krejt fotot.
    */

    if (!foundImages) {

      galleryItems.forEach(function(item) {

        item.classList.add('is-visible');

      });

    }

  }


  function updateVariant() {

    const selectedOptions =
      getSelectedOptions();


    console.log(
      'Selected options:',
      selectedOptions
    );


    const selectedVariant =
      variants.find(function(variant) {

        return variant.options.every(
          function(option, index) {

            return (
              option === selectedOptions[index]
            );

          }
        );

      });


    console.log(
      'Selected variant:',
      selectedVariant
    );


    if (!selectedVariant) {

      variantTitle.textContent =
        'Variant not found';

      variantId.textContent =
        '';

      return;

    }


    variantTitle.textContent =
      selectedVariant.title;


    variantId.textContent =
      selectedVariant.id;


    productPrice.textContent =
      selectedVariant.priceFormatted;


    /*
      NDRYSHO ALBUM FOTOSH
    */

    updateGallery();

  }


  inputs.forEach(function(input) {

    input.addEventListener(
      'change',
      function() {

        updateVariant();

      }
    );

  });


  /*
    Kur hapet faqja
  */

  updateVariant();

})();
</script>


{% schema %}
{
  "name": "Img-color-produkt",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Img-color-produkt"
    }
  ]
}
{% endschema %}