{% assign selected_product = section.settings.product %}

{% if selected_product != blank %}

  <div
    class="product-box"
    id="product-box-{{ section.id }}"
    data-product='{{ selected_product.variants | json }}'
  >

    <!-- PRODUCT TITLE -->
    <h1>{{ selected_product.title }}</h1>


    <!-- PRODUCT PRICE -->
    <p id="product-price-{{ section.id }}">
      {{ selected_product.selected_or_first_available_variant.price | money }}
    </p>


    <!-- MAIN PRODUCT IMAGE -->
    {% assign current_variant = selected_product.selected_or_first_available_variant %}

    {% if current_variant.featured_image %}
      {{
        current_variant.featured_image
        | image_url: width: 800
        | image_tag:
          id: 'main-product-image',
          class: 'main-product-image',
          alt: selected_product.title
      }}
    {% elsif selected_product.featured_image %}
      {{
        selected_product.featured_image
        | image_url: width: 800
        | image_tag:
          id: 'main-product-image',
          class: 'main-product-image',
          alt: selected_product.title
      }}
    {% endif %}


    <!-- OPTIONS -->
    {% for option in selected_product.options_with_values %}

      <h3>{{ option.name }}</h3>

      <div class="product-options">

        {% for option_value in option.values %}

          <label class="product-option">

            <input
              type="radio"
              name="option-{{ section.id }}-{{ option.position }}"
              value="{{ option_value.name | escape }}"
              {% if option_value.selected %}
                checked
              {% endif %}
            >

            {% if option_value.swatch.image %}

              {{
                option_value.swatch.image
                | image_url: width: 100
                | image_tag:
                  class: 'swatch-image',
                  alt: option_value.name
              }}

            {% elsif option_value.swatch.color %}

              <span
                class="color-swatch"
                style="
                  background-color:
                  rgb({{ option_value.swatch.color.rgb }});
                "
              ></span>

            {% else %}

              <span class="option-text">
                {{ option_value.name }}
              </span>

            {% endif %}

          </label>

        {% endfor %}

      </div>

    {% endfor %}


    <!-- VARIANT INFO -->
    <p>
      Variant:
      <strong id="variant-title-{{ section.id }}">
        {{ current_variant.title }}
      </strong>
    </p>

    <p>
      Variant ID:
      <strong id="variant-id-{{ section.id }}">
        {{ current_variant.id }}
      </strong>
    </p>

  </div>

{% else %}

  <p>Select a product in Theme Editor.</p>

{% endif %}


<style>

  .main-product-image {
    display: block;
    width: 100%;
    max-width: 500px;
    height: auto;
    margin-bottom: 20px;
  }

  .product-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .product-option {
    cursor: pointer;
  }

  .product-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .color-swatch {
    display: block;
    width: 42px;
    height: 42px;
    border: 2px solid #ccc;
    border-radius: 50%;
  }

  .swatch-image {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: cover;
    border: 2px solid #ccc;
    border-radius: 8px;
  }

  .option-text {
    display: block;
    padding: 10px 16px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .product-option input:checked + .color-swatch,
  .product-option input:checked + .swatch-image,
  .product-option input:checked + .option-text {
    border: 3px solid #000;
  }

</style>


<script>
document.addEventListener('DOMContentLoaded', function () {

  const productBox =
    document.getElementById('product-box-{{ section.id }}');

  if (!productBox) return;


  // 1. Marrim variantet nga Liquid
  const variants =
    JSON.parse(productBox.dataset.product);


  // 2. Marrim radio buttons
  const inputs =
    productBox.querySelectorAll('input[type="radio"]');


  // 3. Marrim elementet që duam t'i ndryshojmë
  const mainImage =
    productBox.querySelector('.main-product-image');

  const variantTitle =
    document.getElementById('variant-title-{{ section.id }}');

  const variantId =
    document.getElementById('variant-id-{{ section.id }}');

  const productPrice =
    document.getElementById('product-price-{{ section.id }}');


  function updateVariant() {

    // 4. Marrim options që ka zgjedhur klienti
    const selectedOptions = [];

    inputs.forEach(function (input) {

      if (input.checked) {
        selectedOptions.push(input.value);
      }

    });


    console.log('Selected options:', selectedOptions);


    // 5. Gjejmë variantin
    const selectedVariant = variants.find(function (variant) {

      return variant.options.every(function (option, index) {

        return option === selectedOptions[index];

      });

    });


    if (!selectedVariant) {

      console.log('Variant not found');

      return;

    }


    console.log('Selected variant:', selectedVariant);


    // 6. Ndryshojmë variant title
    variantTitle.textContent =
      selectedVariant.title;


    // 7. Ndryshojmë variant ID
    variantId.textContent =
      selectedVariant.id;


    // 8. NDRYSHOJMË FOTOGRAFINË
    if (
      mainImage &&
      selectedVariant.featured_image &&
      selectedVariant.featured_image.src
    ) {

      mainImage.src =
        selectedVariant.featured_image.src;

    }

  }


  // Kur klienti klikon option
  inputs.forEach(function (input) {

    input.addEventListener('change', function () {

      updateVariant();

    });

  });


  // Run njëherë në fillim
  updateVariant();

});
</script>


{% schema %}
{
  "name": "Img-color-produkt",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Img-color-produkt"
    }
  ]
}
{% endschema %}