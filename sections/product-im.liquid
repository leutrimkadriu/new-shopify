{% assign selected_product = section.settings.product %}
{% assign current_variant = selected_product.selected_or_first_available_variant %}

{% if selected_product != blank %}

  <div
    class="product-box"
    id="product-box-{{ section.id }}"
  >

    <h1>{{ selected_product.title }}</h1>

    <p id="product-price-{{ section.id }}">
      {{ current_variant.price | money }}
    </p>


    {%- comment -%}
      MAIN IMAGE
    {%- endcomment -%}

    {% if current_variant.featured_image %}

      {{
        current_variant.featured_image
        | image_url: width: 800
        | image_tag:
          class: 'main-product-image',
          alt: selected_product.title
      }}

    {% elsif selected_product.featured_image %}

      {{
        selected_product.featured_image
        | image_url: width: 800
        | image_tag:
          class: 'main-product-image',
          alt: selected_product.title
      }}

    {% endif %}


    {%- comment -%}
      OPTIONS
    {%- endcomment -%}

    {% for option in selected_product.options_with_values %}

      <h3>{{ option.name }}</h3>

      <div class="product-options">

        {% for option_value in option.values %}

          <label class="product-option">

            <input
              type="radio"
              name="option-{{ section.id }}-{{ option.position }}"
              value="{{ option_value.name | escape }}"
              {% if option_value.selected %}
                checked
              {% endif %}
            >

            {% if option_value.swatch.image %}

              {{
                option_value.swatch.image
                | image_url: width: 100
                | image_tag:
                  class: 'swatch-image',
                  alt: option_value.name
              }}

            {% elsif option_value.swatch.color %}

              <span
                class="color-swatch"
                style="
                  background-color:
                  rgb({{ option_value.swatch.color.rgb }});
                "
              ></span>

            {% else %}

              <span class="option-text">
                {{ option_value.name }}
              </span>

            {% endif %}

          </label>

        {% endfor %}

      </div>

    {% endfor %}


    <p>
      Variant:
      <strong id="variant-title-{{ section.id }}">
        {{ current_variant.title }}
      </strong>
    </p>

    <p>
      Variant ID:
      <strong id="variant-id-{{ section.id }}">
        {{ current_variant.id }}
      </strong>
    </p>


    {%- comment -%}
      VARIANT DATA FOR JAVASCRIPT
    {%- endcomment -%}

    <script
      type="application/json"
      id="variant-data-{{ section.id }}"
    >
      [
        {% for variant in selected_product.variants %}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "image":
              {% if variant.featured_image %}
                {{ variant.featured_image | image_url: width: 800 | json }}
              {% else %}
                null
              {% endif %}
          }
          {% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

  </div>

{% else %}

  <p>Select a product in Theme Editor.</p>

{% endif %}


<style>

.main-product-image {
  display: block;
  width: 100%;
  max-width: 500px;
  height: auto;
  margin-bottom: 20px;
}

.product-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

.product-option {
  cursor: pointer;
}

.product-option input {
  position: absolute;
  opacity: 0;
}

.color-swatch {
  display: block;
  width: 42px;
  height: 42px;
  border: 2px solid #ccc;
  border-radius: 50%;
}

.swatch-image {
  display: block;
  width: 60px;
  height: 60px;
  object-fit: cover;
  border: 2px solid #ccc;
  border-radius: 8px;
}

.option-text {
  display: block;
  padding: 10px 16px;
  border: 2px solid #ccc;
  border-radius: 6px;
}

.product-option input:checked + .color-swatch,
.product-option input:checked + .swatch-image,
.product-option input:checked + .option-text {
  border-color: #000;
  border-width: 3px;
}

</style>


<script>
(function() {

  const productBox =
    document.getElementById('product-box-{{ section.id }}');

  if (!productBox) return;


  const variantData =
    document.getElementById('variant-data-{{ section.id }}');

  if (!variantData) return;


  const variants =
    JSON.parse(variantData.textContent);


  const inputs =
    productBox.querySelectorAll('input[type="radio"]');

  const mainImage =
    productBox.querySelector('.main-product-image');

  const variantTitle =
    document.getElementById('variant-title-{{ section.id }}');

  const variantId =
    document.getElementById('variant-id-{{ section.id }}');


  function updateVariant() {

    const selectedOptions = [];


    inputs.forEach(function(input) {

      if (input.checked) {

        selectedOptions.push(input.value);

      }

    });


    console.log(
      'Selected options:',
      selectedOptions
    );


    const selectedVariant =
      variants.find(function(variant) {

        return variant.options.every(
          function(option, index) {

            return option === selectedOptions[index];

          }
        );

      });


    console.log(
      'Selected variant:',
      selectedVariant
    );


    if (!selectedVariant) {

      console.log('Variant not found');

      return;

    }


    variantTitle.textContent =
      selectedVariant.title;


    variantId.textContent =
      selectedVariant.id;


    /*
      NDRYSHIMI I FOTOS
    */

    if (
      mainImage &&
      selectedVariant.image
    ) {

      mainImage.src =
        selectedVariant.image;

      /*
        image_tag mund të krijojë srcset.
        E heqim që browser-i të mos vazhdojë
        me fotografinë e vjetër.
      */

      mainImage.removeAttribute('srcset');

      console.log(
        'New image:',
        selectedVariant.image
      );

    } else {

      console.log(
        'Ky variant nuk ka featured image'
      );

    }

  }


  inputs.forEach(function(input) {

    input.addEventListener(
      'change',
      updateVariant
    );

  });


  updateVariant();

})();
</script>


{% schema %}
{
  "name": "Img-color-produkt",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Img-color-produkt"
    }
  ]
}
{% endschema %}