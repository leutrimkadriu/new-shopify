{% assign selected_product = section.settings.product %}

{% if selected_product != blank %}

  <div
    class="variant-picker"
    data-product='{{ selected_product.variants | json }}'
  >
    {% if selected_product.featured_image %}
  {{
    selected_product.featured_image
    | image_url: width: 600
    | image_tag: alt: selected_product.title
  }}
{% endif %}

    {% for option in selected_product.options_with_values %}

      <h3>{{ option.name }}</h3>

      <div class="product-options">

        {% for option_value in option.values %}
            

          <label>
            <input
              type="radio"
              name="option-{{ option.position }}"
              value="{{ option_value.name | escape }}"
              {% if option_value.selected %}
                checked
              {% endif %}
            >

            {% if option_value.swatch.image %}

              {{
                option_value.swatch.image
                | image_url: width: 100
                | image_tag: alt: option_value.name
              }}

            {% elsif option_value.swatch.color %}

              <span
                class="color-swatch"
                style="
                  display:inline-block;
                  width:40px;
                  height:40px;
                  border-radius:50%;
                  border:1px solid #ccc;
                  background-color:rgb({{ option_value.swatch.color.rgb }});
                "
              ></span>

            {% else %}

              <span>{{ option_value.name }}</span>

            {% endif %}
          </label>

        {% endfor %}

      </div>

    {% endfor %}

    <p>
      Selected variant:
      <strong id="variant-title"></strong>
    </p>

    <p>
      Variant ID:
      <strong id="variant-id"></strong>
    </p>

  </div>

{% endif %}

<style>

.product-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.product-option img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 8px;
}

.color-swatch {
  display: inline-block;
  width: 40px;
  height: 40px;
  border: 1px solid #ccc;
  border-radius: 50%;
}

.option-text {
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid #ccc;
  border-radius: 6px;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const picker = document.querySelector('.variant-picker');

  if (!picker) return;

  const variants = JSON.parse(picker.dataset.product);

  const inputs = picker.querySelectorAll('input[type="radio"]');

  const variantTitle = document.getElementById('variant-title');
  const variantId = document.getElementById('variant-id');

  function updateVariant() {

    const selectedOptions = [];

    inputs.forEach(input => {
      if (input.checked) {
        selectedOptions.push(input.value);
      }
    });

    const variant = variants.find(variant => {
      return variant.options.every((option, index) => {
        return option === selectedOptions[index];
      });
    });

    if (!variant) {
      variantTitle.textContent = 'Variant not found';
      variantId.textContent = '';
      return;
    }

    variantTitle.textContent = variant.title;
    variantId.textContent = variant.id;

    console.log('Selected variant:', variant);
  }

  inputs.forEach(input => {
    input.addEventListener('change', updateVariant);
  });

  updateVariant();

});
</script>


{% schema %}
{
  "name": "Img-color-produkt",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Img-color-produkt"
    }
  ]
}
{% endschema %}