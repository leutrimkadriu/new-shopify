<div>
<h1>{{ product.title }}</h1>
<p>{{ product.price }}</p>
<img src="{{ product.images }}" />
</div>

{% for option in product.options_with_values %}

  <h3>{{ option.name }}</h3>

  {% for option_value in option.values %}

    {% if option_value.swatch.color %}

      <span
        style="
          display: inline-block;
          width: 40px;
          height: 40px;
          border: 1px solid #ccc;
          border-radius: 50%;
          background-color: rgb({{ option_value.swatch.color.rgb }});
        "
      ></span>

    {% else %}

      <span>
        {{ option_value.name }}
      </span>

    {% endif %}

  {% endfor %}

{% endfor %}

{% schema %}
{
    "name": "Img-color-produkt",
    "settings": [{
        "type": "product",
        "id": "product",
        "label": "product"
    }],
    "presets": [
        {
        "name": "Img-color-produkt"}
    ]
}


{% endschema %}