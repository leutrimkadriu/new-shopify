<div
  class="nx-header-wrap{% if section.settings.sticky %} is-sticky{% endif %}{% if section.settings.transparent_home and request.page_type == 'index' %} is-transparent{% endif %}"
  style="--nx-logo-height: {{ section.settings.logo_height }}px"
>
  <header class="nx-header nx-header--{{ section.settings.layout }}">
    <button class="nx-icon-button nx-mobile-toggle" type="button" data-open="NxMobileMenu" aria-label="{{ 'accessibility.menu' | t }}" aria-controls="NxMobileMenu" aria-expanded="false">
      {% render 'icon', icon: 'menu' %}
    </button>

    <a class="nx-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: widths: '80,120,160,220,320,440', width: settings.logo_width, alt: shop.name }}
      {% else %}
        <span>{{ shop.name | default: 'VEYLUNE' | escape }}</span>
      {% endif %}
    </a>

    <nav class="nx-header__nav" aria-label="{{ 'accessibility.primary_navigation' | t }}">
      <ul role="list">
        {% for link in section.settings.menu.links %}
          <li>
            {% if link.links != blank %}
              <details>
                <summary>{{ link.title | escape }} {% render 'icon', icon: 'chevron' %}</summary>
                <div class="nx-mega">
                  <div class="nx-mega__links">
                    <a class="nx-mega__heading" href="{{ link.url }}">{{ link.title | escape }}</a>
                    <ul role="list">
                      {% for child in link.links %}
                        <li>
                          <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                          {% if child.links != blank %}
                            <ul role="list">
                              {% for grandchild in child.links %}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                  {% assign menu_parent = link.title | handle %}
                  {% assign promo_count = 0 %}
                  {% for block in section.blocks %}
                    {% assign promo_parent = block.settings.menu_item | handle %}
                    {% if block.type == 'promo' and promo_parent == menu_parent %}{% assign promo_count = promo_count | plus: 1 %}{% endif %}
                  {% endfor %}
                  {% if promo_count > 0 %}<div class="nx-mega__promos">
                    {% for block in section.blocks %}
                      {% assign promo_parent = block.settings.menu_item | handle %}
                      {% if block.type == 'promo' and promo_parent == menu_parent %}
                        <a class="nx-mega__promo" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                          {% render 'responsive-image', image: block.settings.image, sizes: '(min-width: 990px) 240px, 1px' %}
                          <span class="nx-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                          <strong>{{ block.settings.heading | escape }}</strong>
                          {% if block.settings.text != blank %}<span>{{ block.settings.text | escape }}</span>{% endif %}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>{% endif %}
                </div>
              </details>
            {% else %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="nx-header__actions">
      <button class="nx-icon-button nx-header__action" type="button" data-open="NxSearchDrawer" aria-label="{{ 'accessibility.search' | t }}" aria-controls="NxSearchDrawer" aria-expanded="false">
        {% render 'icon', icon: 'search' %}
      </button>

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <shopify-account class="nx-header__account" menu="{{ section.settings.customer_account_menu }}">
          <span class="nx-icon-button" slot="signed-out-avatar" aria-label="{{ 'accessibility.account' | t }}">{% render 'icon', icon: 'account' %}</span>
        </shopify-account>
      {% endif %}

      {% if settings.cart_drawer %}
        <button class="nx-icon-button nx-header__action no-js-hidden" type="button" data-open="NxCartDrawer" aria-label="{{ 'accessibility.cart' | t }}" aria-controls="NxCartDrawer" aria-expanded="false">
          {% render 'icon', icon: 'cart' %}
          <span class="nx-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
        <noscript>
          <a class="nx-icon-button nx-header__action" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
            {% render 'icon', icon: 'cart' %}
            <span class="nx-header__cart-count"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
          </a>
        </noscript>
      {% else %}
        <a class="nx-icon-button nx-header__action" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
          {% render 'icon', icon: 'cart' %}
          <span class="nx-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      {% endif %}
    </div>
  </header>
</div>

<nx-drawer id="NxMobileMenu" class="nx-drawer" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.primary_navigation' | t }}">
  <button class="nx-drawer__overlay" type="button" data-close aria-label="{{ 'accessibility.close' | t }}"></button>
  <div class="nx-drawer__panel nx-mobile-menu" data-panel tabindex="-1">
    <header class="nx-drawer__header">
      <span class="nx-mobile-menu__brand">{{ shop.name | escape }}</span>
      <button class="nx-icon-button" type="button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    </header>

    <form class="nx-mobile-menu__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="MobileMenuSearch">{{ 'search.title' | t }}</label>
      <input id="MobileMenuSearch" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}">
      <button class="nx-icon-button" aria-label="{{ 'search.submit' | t }}">{% render 'icon', icon: 'search' %}</button>
    </form>

    <nav>
      <ul role="list">
        {% for link in section.settings.menu.links %}
          <li>
            {% if link.links != blank %}
              <details class="nx-mobile-menu__group">
                <summary>{{ link.title | escape }} {% render 'icon', icon: 'chevron' %}</summary>
                <div>
                  <a class="nx-mobile-menu__all" href="{{ link.url }}">{{ 'general.view_all' | t: title: link.title }}</a>
                  <ul role="list">
                    {% for child in link.links %}
                      <li>
                        {% if child.links != blank %}
                          <details class="nx-mobile-menu__subgroup">
                            <summary>{{ child.title | escape }} {% render 'icon', icon: 'chevron' %}</summary>
                            <ul role="list">
                              <li><a href="{{ child.url }}">{{ 'general.view_all' | t: title: child.title }}</a></li>
                              {% for grandchild in child.links %}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                              {% endfor %}
                            </ul>
                          </details>
                        {% else %}
                          <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </details>
            {% else %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    {% if section.settings.show_localization %}{% render 'localization-form', id: 'mobile-menu' %}{% endif %}
  </div>
</nx-drawer>

<noscript>
  <nav class="nx-no-js-menu nx-page-width" aria-label="{{ 'accessibility.primary_navigation' | t }}">
    <ul role="list">
      {% for link in section.settings.menu.links %}
        <li>
          {% if link.links != blank %}
            <details>
              <summary>{{ link.title | escape }}</summary>
              <ul role="list">
                <li><a href="{{ link.url }}">{{ 'general.view_all' | t: title: link.title }}</a></li>
                {% for child in link.links %}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{% endfor %}
              </ul>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
</noscript>

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "logo_left", "label": "Logo left, navigation center" },
        { "value": "logo_center", "label": "Logo centered" },
        { "value": "compact", "label": "Compact editorial" }
      ],
      "default": "logo_left"
    },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "transparent_home", "label": "Transparent on home page", "default": false },
    { "type": "range", "id": "logo_height", "min": 24, "max": 64, "step": 2, "unit": "px", "label": "Logo height", "default": 34 },
    { "type": "checkbox", "id": "show_account", "label": "Show customer account", "default": true },
    { "type": "link_list", "id": "customer_account_menu", "label": "Customer account menu", "default": "customer-account-main-menu" },
    { "type": "checkbox", "id": "show_localization", "label": "Show localization in mobile menu", "default": true }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Mega navigation story",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Parent main menu item", "info": "Enter the exact top-level main menu label that should show this story." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A considered selection" },
        { "type": "text", "id": "text", "label": "Supporting text", "default": "Discover pieces chosen for material, form, and longevity." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
