<section class="nx-section nx-page-width nx-text-center"><div class="nx-eyebrow">404 / Lost object</div><h1>{{ 'templates.404.title' | t }}</h1><p>{{ 'templates.404.subtext' | t }}</p><a class="nx-button" href="{{ routes.all_products_collection_url }}">{{ 'templates.404.button' | t }}</a><form class="nx-search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="Search404">{{ 'search.title' | t }}</label><input id="Search404" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}"><button class="nx-icon-button" aria-label="{{ 'search.submit' | t }}">{% render 'icon', icon: 'search' %}</button></form></section>
{% schema %}{"name":"404 page","settings":[]}{% endschema %}
