<nx-rail class="nx-section"><div class="nx-page-width"><header class="nx-section-heading"><div><div class="nx-eyebrow">{{ section.settings.eyebrow | escape }}</div><h2>{{ section.settings.heading | escape }}</h2></div></header><div class="nx-rail" data-rail style="--nx-rail-size:{{ section.settings.card_size }}%" tabindex="0" aria-label="{{ section.settings.heading | escape }}">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', card_product: product, card_style: section.settings.card_style %}{% else %}{% for i in (1..5) %}<article class="nx-product-card"><div class="nx-product-card__media"><div class="nx-placeholder">{{ 'product-' | append: i | placeholder_svg_tag }}</div></div><h3 class="nx-product-card__title">Discovery {{ i }}</h3></article>{% endfor %}{% endfor %}</div>{% if section.settings.progress %}<div class="nx-rail-progress"><span data-progress></span></div>{% endif %}</div></nx-rail>
{% schema %}{"name":"Kinetic collection rail","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Browse sideways / 02"},{"type":"text","id":"heading","label":"Heading","default":"In motion"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":4,"max":16,"step":1,"label":"Products to show","default":8},{"type":"range","id":"card_size","min":20,"max":45,"step":5,"unit":"%","label":"Desktop card width","default":30},{"type":"select","id":"card_style","label":"Card style","options":[{"value":"minimal","label":"Minimal"},{"value":"editorial","label":"Editorial"},{"value":"commerce","label":"Commerce"}],"default":"editorial"},{"type":"checkbox","id":"progress","label":"Show progress","default":true}],"presets":[{"name":"Kinetic collection rail"}]}{% endschema %}
