<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>{{ 'gift_cards.issued.title' | t }} · {{ shop.name | escape }}</title>{{ content_for_header }}<style>body{margin:0;background:#f7f5ef;color:#171714;font-family:system-ui,sans-serif}.card{width:min(100% - 2rem,620px);margin:8vh auto;padding:clamp(1.5rem,6vw,4rem);border:1px solid #d8d3ca;text-align:center}.code{margin:2rem 0;padding:1rem;border:1px dashed;font:1.25rem monospace;letter-spacing:.12em}.balance{font-size:2.5rem}img{max-width:100%}.button{display:inline-block;padding:.8rem 1.2rem;background:#171714;color:#fff;text-decoration:none}@media print{.no-print{display:none}}</style></head><body><main class="card"><p>{{ shop.name | escape }}</p><h1>{{ 'gift_cards.issued.title' | t }}</h1><p>{{ 'gift_cards.issued.subtext' | t }}</p><div class="balance">{{ gift_card.balance | money }}</div>{% if gift_card.expired %}<p>{{ 'gift_cards.issued.expired' | t }}</p>{% endif %}<div id="gift-card-code" class="code">{{ gift_card.code | format_code }}</div>{% if gift_card.pass_url %}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"></a>{% endif %}<p class="no-print"><a class="button" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a></p></main><script>document.querySelector('.code')?.addEventListener('click',async(e)=>{try{await navigator.clipboard.writeText(e.currentTarget.textContent.trim())}catch(_){} })</script></body></html>
