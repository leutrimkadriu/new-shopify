<nx-cart-drawer id="NxCartDrawer" class="nx-drawer" aria-label="{{ 'cart.title' | t }}"><button class="nx-drawer__overlay" type="button" data-close aria-label="{{ 'accessibility.close' | t }}"></button><div class="nx-drawer__panel" data-panel><header class="nx-drawer__header"><h2>{{ 'cart.title' | t }}</h2><button class="nx-icon-button" type="button" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button></header>{% if cart.item_count == 0 %}<div class="nx-section"><p>{{ 'cart.empty' | t }}</p><a class="nx-button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>{% else %}{% if settings.shipping_progress %}{% assign remaining = settings.shipping_threshold | minus: cart.total_price %}<div>{% if remaining > 0 %}<p>{{ 'cart.free_shipping_remaining' | t: amount: remaining | money }}</p>{% else %}<p>{{ 'cart.free_shipping_success' | t }}</p>{% endif %}<div class="nx-progress"><span style="--progress:{{ cart.total_price | times: 100 | divided_by: settings.shipping_threshold | at_most: 100 }}%"></span></div></div>{% endif %}<div>{% for item in cart.items %}{% render 'cart-item', item: item, line: forloop.index %}{% endfor %}</div><div><p><strong>{{ 'cart.subtotal' | t }}</strong> {{ cart.total_price | money_with_currency }}</p><form action="{{ routes.cart_url }}" method="post">{% if settings.cart_note %}<div class="nx-field"><label for="DrawerCartNote">{{ 'cart.note' | t }}</label><textarea id="DrawerCartNote" name="note">{{ cart.note }}</textarea></div>{% endif %}<button class="nx-button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></form></div>{% endif %}</div></nx-cart-drawer>
