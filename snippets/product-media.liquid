<div class="nx-product-gallery__item" data-media-id="{{ media.id }}">
  {% case media.media_type %}{% when 'image' %}{% render 'responsive-image', image: media.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', loading: loading, fetchpriority: fetchpriority %}{% when 'video' %}{{ media | media_tag: image_size: '1200x', controls: true }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}{% endcase %}
</div>
