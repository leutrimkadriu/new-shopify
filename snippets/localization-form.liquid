{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% form 'localization', class: 'nx-localization' %}{% if localization.available_countries.size > 1 %}<label class="visually-hidden" for="Country-{{ id }}">Country/region</label><select id="Country-{{ id }}" name="country_code" data-localization-select>{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="visually-hidden" for="Language-{{ id }}">Language</label><select id="Language-{{ id }}" name="locale_code" data-localization-select>{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endif %}{% endform %}{% endif %}
