<div class="nx-cart-item" data-key="{{ item.key }}">
  <a href="{{ item.url }}">
    {% if item.image %}
      {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', sizes: '90px', alt: item.image.alt | default: item.title | escape }}
    {% endif %}
  </a>
  <div class="nx-cart-item__info">
    <a class="nx-cart-item__title" href="{{ item.url }}"><strong>{{ item.title | escape }}</strong></a>
    {% unless item.product.has_only_default_variant %}
      <dl class="nx-cart-item__options">
        {% for option in item.options_with_values %}<div><dt>{{ option.name | escape }}:</dt><dd>{{ option.value | escape }}</dd></div>{% endfor %}
      </dl>
    {% endunless %}
    {% if item.selling_plan_allocation %}<small class="nx-cart-item__selling-plan">{{ 'cart.selling_plan' | t }}: {{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}
    {% for property in item.properties %}
      {% unless property.last == blank or property.first contains '_' %}
        <small>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</small>
      {% endunless %}
    {% endfor %}
    {% for discount in item.line_level_discount_allocations %}
      <small class="nx-cart-item__discount">{% render 'icon', icon: 'check' %} {{ discount.discount_application.title | escape }} (−{{ discount.amount | money_with_currency }})</small>
    {% endfor %}
    <div class="nx-price">
      <span{% if item.original_price > item.final_price %} class="nx-price__sale"{% endif %}>{{ item.final_price | money_with_currency }}</span>
      {% if item.original_price > item.final_price %}<s>{{ item.original_price | money_with_currency }}</s>{% endif %}
    </div>
    {% if item.unit_price_measurement %}<small class="nx-cart-item__unit-price">{{ 'cart.unit_price' | t }}: {{ item.unit_price | unit_price_with_measurement: item.unit_price_measurement }}</small>{% endif %}
    <div class="nx-cart-item__actions">
      <div class="nx-quantity">
        <button type="button" data-quantity-action data-cart-key="{{ item.key | escape }}" data-delta="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
        <input data-cart-quantity data-cart-key="{{ item.key | escape }}" name="updates[]" value="{{ item.quantity }}" min="1" step="1" type="number" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
        <button type="button" data-quantity-action data-cart-key="{{ item.key | escape }}" data-delta="1" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
      </div>
      <a class="nx-cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove data-cart-key="{{ item.key | escape }}" aria-label="{{ 'cart.remove' | t: title: item.title }}">{{ 'cart.remove_short' | t }}</a>
    </div>
  </div>
  <div class="nx-cart-item__total">{{ item.final_line_price | money_with_currency }}</div>
</div>
