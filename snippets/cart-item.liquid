<div class="nx-cart-item" data-key="{{ item.key }}">
  <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', sizes: '90px', alt: item.image.alt | default: item.product.title | escape }}{% endif %}</a>
  <div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<div class="nx-muted">{{ item.variant.title | escape }}</div>{% endunless %}{% for property in item.properties %}{% unless property.last == blank or property.first contains '_' %}<small>{{ property.first }}: {{ property.last }}</small>{% endunless %}{% endfor %}<div>{% render 'price', product: item %}</div><div class="nx-quantity"><button type="button" data-quantity-action data-line="{{ line }}" data-delta="-1" aria-label="Decrease quantity">−</button><input data-cart-quantity data-line="{{ line }}" name="updates[]" value="{{ item.quantity }}" min="0" type="number" aria-label="{{ 'products.product.quantity' | t }}"><button type="button" data-quantity-action data-line="{{ line }}" data-delta="1" aria-label="Increase quantity">+</button></div> <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t: title: item.title }}</a></div>
  <div class="nx-cart-item__total">{{ item.final_line_price | money }}</div>
</div>
