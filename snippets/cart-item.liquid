<div class="nx-cart-item" data-key="{{ item.key }}">
  <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', sizes: '90px', alt: item.image.alt | default: item.product.title | escape }}{% endif %}</a>
  <div class="nx-cart-item__info"><a class="nx-cart-item__title" href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>{% unless item.product.has_only_default_variant %}<div class="nx-muted">{{ item.variant.title | escape }}</div>{% endunless %}{% for property in item.properties %}{% unless property.last == blank or property.first contains '_' %}<small>{{ property.first }}: {{ property.last }}</small>{% endunless %}{% endfor %}<div class="nx-price"><span{% if item.original_price > item.final_price %} class="nx-price__sale"{% endif %}>{{ item.final_price | money_with_currency }}</span>{% if item.original_price > item.final_price %}<s>{{ item.original_price | money_with_currency }}</s>{% endif %}</div><div class="nx-cart-item__actions"><div class="nx-quantity"><button type="button" data-quantity-action data-cart-key="{{ item.key | escape }}" data-delta="-1" aria-label="Decrease quantity">−</button><input data-cart-quantity data-cart-key="{{ item.key | escape }}" name="updates[]" value="{{ item.quantity }}" min="1" step="1" type="number" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}"><button type="button" data-quantity-action data-cart-key="{{ item.key | escape }}" data-delta="1" aria-label="Increase quantity">+</button></div><a class="nx-cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove data-cart-key="{{ item.key | escape }}" aria-label="{{ 'cart.remove' | t: title: item.title }}">{{ 'cart.remove_short' | t }}</a></div></div>
  <div class="nx-cart-item__total">{{ item.final_line_price | money_with_currency }}</div>
</div>
