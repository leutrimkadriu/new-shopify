{%- liquid
  assign recipient_active = false
  if form.email != blank or form.name != blank or form.message != blank or form.send_on != blank or form.errors != blank
    assign recipient_active = true
  endif
  assign recipient_id = form_id | append: '-Recipient'
-%}
<nx-gift-recipient class="nx-recipient"{% if noscript %} data-no-script{% endif %}>
  <label class="nx-recipient__toggle" for="{{ recipient_id }}-Enabled">
    <input
      id="{{ recipient_id }}-Enabled"
      type="checkbox"
      name="properties[__shopify_send_gift_card_to_recipient]"
      value="true"
      data-recipient-toggle
      {% if recipient_active %}checked{% endif %}
    >
    <span>{{ 'recipient.form.checkbox' | t }}</span>
  </label>

  <div class="nx-recipient__fields" data-recipient-fields{% unless recipient_active or noscript %} hidden{% endunless %}>
    <div class="nx-field">
      <label for="{{ recipient_id }}-Email">{{ 'recipient.form.email_label' | t }} <span aria-hidden="true">*</span></label>
      <input
        id="{{ recipient_id }}-Email"
        type="email"
        name="properties[Recipient email]"
        value="{{ form.email | escape }}"
        autocomplete="email"
        {% unless noscript %}required{% endunless %}
        {% unless recipient_active or noscript %}disabled{% endunless %}
        {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ recipient_id }}-EmailError"{% endif %}
      >
      {% if form.errors contains 'email' %}<small id="{{ recipient_id }}-EmailError" class="nx-form-error">{{ form.errors.messages.email }}</small>{% endif %}
    </div>

    <div class="nx-field">
      <label for="{{ recipient_id }}-Name">{{ 'recipient.form.name_label' | t }}</label>
      <input
        id="{{ recipient_id }}-Name"
        type="text"
        name="properties[Recipient name]"
        value="{{ form.name | escape }}"
        autocomplete="name"
        maxlength="255"
        {% unless recipient_active or noscript %}disabled{% endunless %}
        {% if form.errors contains 'name' %}aria-invalid="true" aria-describedby="{{ recipient_id }}-NameError"{% endif %}
      >
      {% if form.errors contains 'name' %}<small id="{{ recipient_id }}-NameError" class="nx-form-error">{{ form.errors.messages.name }}</small>{% endif %}
    </div>

    <div class="nx-field">
      <label for="{{ recipient_id }}-Message">{{ 'recipient.form.message_label' | t }}</label>
      <textarea
        id="{{ recipient_id }}-Message"
        name="properties[Message]"
        rows="4"
        maxlength="200"
        {% unless recipient_active or noscript %}disabled{% endunless %}
        {% if form.errors contains 'message' %}aria-invalid="true" aria-describedby="{{ recipient_id }}-MessageError"{% endif %}
      >{{ form.message | escape }}</textarea>
      <small class="nx-muted">{{ 'recipient.form.message_hint' | t }}</small>
      {% if form.errors contains 'message' %}<small id="{{ recipient_id }}-MessageError" class="nx-form-error">{{ form.errors.messages.message }}</small>{% endif %}
    </div>

    <div class="nx-field">
      <label for="{{ recipient_id }}-SendOn">{{ 'recipient.form.send_on_label' | t }}</label>
      <input
        id="{{ recipient_id }}-SendOn"
        type="date"
        name="properties[Send on]"
        value="{{ form.send_on | escape }}"
        pattern="\d{4}-\d{2}-\d{2}"
        data-recipient-send-on
        {% unless recipient_active or noscript %}disabled{% endunless %}
        {% if form.errors contains 'send_on' %}aria-invalid="true" aria-describedby="{{ recipient_id }}-SendOnError"{% endif %}
      >
      <small class="nx-muted">{{ 'recipient.form.send_on_hint' | t }}</small>
      {% if form.errors contains 'send_on' %}<small id="{{ recipient_id }}-SendOnError" class="nx-form-error">{{ form.errors.messages.send_on }}</small>{% endif %}
    </div>

    <input type="hidden" name="properties[__shopify_offset]" value="" data-recipient-offset{% unless recipient_active or noscript %} disabled{% endunless %}>
  </div>
</nx-gift-recipient>
