<nx-variant-selects data-section="{{ section.id }}" data-form="product-form-{{ section.id }}">
  {% for option in product.options_with_values %}
    {% if block.settings.picker_type == 'dropdown' %}<label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label><div class="nx-variant-select"><select id="Option-{{ section.id }}-{{ forloop.index0 }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>
    {% else %}<fieldset class="nx-variant-options{% if block.settings.picker_type == 'swatch' %} nx-variant-options--swatch{% endif %}"><legend>{{ option.name }}</legend>{% for value in option.values %}<div class="nx-option"><input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ option.name }}-{{ section.id }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"{% if block.settings.picker_type == 'swatch' and value.swatch.color %} style="--nx-swatch:{{ value.swatch.color }}"{% endif %}><span>{{ value }}</span></label></div>{% endfor %}</fieldset>{% endif %}
  {% endfor %}
  <script type="application/json">{{ product.variants | json }}</script>
</nx-variant-selects>
